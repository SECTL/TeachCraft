<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:MeetRoster.App"
        x:Class="MeetRoster.App.EventEditorWindow"
        x:DataType="app:EventEditorViewModel"
        Title="选择项目"
        Width="560" Height="640"
        MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}">
    <Window.Styles>
        <Style Selector="Button.choice">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PinnedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        </Style>
        <Style Selector="Button.choice:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EBE6D8" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Border Grid.Row="0" Classes="dialog-header">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="选择项目" Classes="section-title" FontSize="18" />
                    <TextBlock Text="{Binding AthleteName}" Classes="helper" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SlotLabel}" FontFamily="{StaticResource MonoFont}"
                               FontSize="10.5" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ActionHint}" Classes="helper" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="workspace-panel" Padding="12" Margin="16,12,16,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Classes="field-label" Text="{Binding CurrentLabel}" />
                    <TextBlock Text="{Binding CurrentText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsGroupMode}" />
                    <StackPanel Spacing="4" IsVisible="{Binding IsGroupMode}">
                        <TextBlock Text="{Binding SelectedCountText}" Classes="helper" />
                        <ItemsControl ItemsSource="{Binding SelectedEvents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="seat-tag"
                                            Background="{StaticResource WashHoverBrush}"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            Margin="0,0,5,4">
                                        <TextBlock Text="{Binding}" FontSize="10.5"
                                                   Foreground="{StaticResource InkBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost top" Content="清空本格" Click="OnClear"
                        IsVisible="{Binding ShowClearSingle}"
                        AutomationProperties.Name="清空本格" />
                <Button Grid.Column="1" Classes="ghost top" Content="清空全部" Click="OnClear"
                        IsVisible="{Binding ShowClearGroup}"
                        AutomationProperties.Name="清空全部已选项目" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Spacing="6" Margin="16,12,16,0">
            <TextBox Classes="search compact" x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="搜索项目"
                     AutomationProperties.Name="搜索项目" />
            <TextBlock Classes="helper" Text="{Binding Hint}" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="16,10,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:EventChoiceViewModel">
                            <Button Classes="choice" Click="OnChoose"
                                    AutomationProperties.Name="{Binding AutomationName}">
                                <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="9">
                                    <Border Width="4" Height="30" CornerRadius="2"
                                            Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center" IsVisible="{Binding IsCurrent}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <TextBlock Text="{Binding EventName}" FontSize="12.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding Meta}" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}"
                                                   FontSize="10" Foreground="{StaticResource AccentDeepBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="seat-tag">
                                        <TextBlock Text="{Binding ReplaceText}" FontSize="10"
                                                   Foreground="{StaticResource InkSoftBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding IsEmpty}" Spacing="5"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding EmptyText}" Classes="section-title"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="点击项目即选入当前格并替换原项目；清空后该格回到「未报」。"
                           Classes="helper" VerticalAlignment="Center"
                           IsVisible="{Binding !IsGroupMode}" />
                <TextBlock Text="{Binding GroupFooterHint}"
                           Classes="helper" VerticalAlignment="Center"
                           IsVisible="{Binding IsGroupMode}" />
                <Button Grid.Column="1" Classes="primary top" Content="完成" Click="OnDone" IsDefault="True"
                        Padding="16,7" IsVisible="{Binding IsGroupMode}"
                        AutomationProperties.Name="完成选择" />
                <Button Grid.Column="2" Classes="ghost top" Content="取消" Click="OnCancel"
                        Padding="14,7" IsCancel="True"
                        AutomationProperties.Name="取消选择" />
            </Grid>
        </Border>
    </Grid>
</Window>
