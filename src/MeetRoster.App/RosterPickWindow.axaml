<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:MeetRoster.App"
        x:Class="MeetRoster.App.RosterPickWindow"
        x:DataType="app:RosterPickViewModel"
        Title="从名单选择运动员"
        Width="520" Height="640"
        MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}">
    <Window.Styles>
        <Style Selector="Button.choice">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PinnedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        </Style>
        <Style Selector="Button.choice:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EBE6D8" />
        </Style>
        <Style Selector="Button.choice:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style Selector="Button.choice:disabled">
            <Setter Property="Opacity" Value="0.62" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" Classes="dialog-header">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="从名单选择运动员" Classes="section-title" FontSize="18" />
                    <TextBlock Text="{Binding ClassName, StringFormat='写入 {0}'}" Classes="helper" FontSize="11" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SelectedCountText}" FontFamily="{StaticResource MonoFont}"
                           FontSize="10.5" Foreground="{StaticResource AccentDeepBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="6" Margin="16,12,16,0">
            <TextBox Classes="search compact" x:Name="SearchBox" Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="搜索姓名或班级"
                     AutomationProperties.Name="搜索名单" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Classes="helper" Text="{Binding ActionHint}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="link" Content="全选可见" Click="OnSelectAll" FontSize="10.5" />
                    <Button Classes="link" Content="清空" Click="OnClear" FontSize="10.5" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" Margin="16,10,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Candidates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:RosterCandidateViewModel">
                            <Button Classes="choice" Click="OnPick"
                                    IsEnabled="{Binding CanSelect}"
                                    AutomationProperties.Name="{Binding AutomationName}">
                                <Grid ColumnDefinitions="4,*,Auto" ColumnSpacing="9">
                                    <Border Width="4" Height="30" CornerRadius="2"
                                            Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center" IsVisible="{Binding IsSelected}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding GenderLabel}" Classes="helper" />
                                            <Border Classes="seat-tag" IsVisible="{Binding HasClassLabel}">
                                                <TextBlock Text="{Binding ClassLabel}" FontSize="9.5"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" Classes="seat-tag">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                   Foreground="{StaticResource InkSoftBrush}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding IsEmpty}" Spacing="5"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding EmptyText}" Classes="section-title"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="名单只在本机读取；完成后为第一位选项目，其余点各自的项目格修改。"
                           Classes="helper" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="primary top" Content="完成" Click="OnDone" IsDefault="True"
                        Padding="16,7"
                        AutomationProperties.Name="完成选择" />
                <Button Grid.Column="2" Classes="ghost top" Content="取消" Click="OnCancel"
                        Padding="14,7" IsCancel="True"
                        AutomationProperties.Name="取消选择" />
            </Grid>
        </Border>
    </Grid>
</Window>
