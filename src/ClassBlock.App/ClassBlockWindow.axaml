<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:ClassBlock.App"
        xmlns:ct="using:ClassBlock.Core.Timetable"
        x:Class="ClassBlock.App.ClassBlockWindow"
        x:DataType="app:ClassBlockViewModel"
        Title="时序 · ClassBlock"
        Width="1440" Height="920"
        MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PaperBrush}">
    <Design.DataContext>
        <app:ClassBlockViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="ListBox.classes">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.classes ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="ListBox.classes ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PinnedBrush}" />
        </Style>
        <Style Selector="ListBox.classes ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1EEE5" />
        </Style>
        <Style Selector="Border.class-badge">
            <Setter Property="Background" Value="{StaticResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="MinWidth" Value="38" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ==================== 顶栏 ==================== -->
        <Border Grid.Row="0" Classes="app-topbar">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Viewbox Width="30" Height="30">
                        <Canvas Width="120" Height="120">
                            <Rectangle Canvas.Left="10" Canvas.Top="10" Width="100" Height="100"
                                       RadiusX="24" RadiusY="24" Fill="#FAF9F5"
                                       Stroke="#E7E3D8" StrokeThickness="3"/>
                            <Rectangle Canvas.Left="26" Canvas.Top="26" Width="13" Height="6"
                                       RadiusX="2" RadiusY="2" Fill="#141413"/>
                            <Rectangle Canvas.Left="43" Canvas.Top="26" Width="13" Height="6"
                                       RadiusX="2" RadiusY="2" Fill="#85806F"/>
                            <Rectangle Canvas.Left="60" Canvas.Top="26" Width="13" Height="6"
                                       RadiusX="2" RadiusY="2" Fill="#3D3B36"/>
                            <Rectangle Canvas.Left="77" Canvas.Top="26" Width="17" Height="6"
                                       RadiusX="2" RadiusY="2" Fill="#E7E3D8"/>
                            <Rectangle Canvas.Left="26" Canvas.Top="36" Width="13" Height="22"
                                       RadiusX="2.5" RadiusY="2.5" Fill="#3D3B36"/>
                            <Rectangle Canvas.Left="26" Canvas.Top="62" Width="13" Height="14"
                                       RadiusX="2.5" RadiusY="2.5" Fill="#E7E3D8"/>
                            <Rectangle Canvas.Left="26" Canvas.Top="80" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#85806F"/>
                            <Rectangle Canvas.Left="43" Canvas.Top="36" Width="13" Height="14"
                                       RadiusX="2.5" RadiusY="2.5" Fill="#85806F"/>
                            <Rectangle Canvas.Left="43" Canvas.Top="54" Width="13" Height="22"
                                       RadiusX="2.5" RadiusY="2.5" Fill="#D97757"/>
                            <Rectangle Canvas.Left="43" Canvas.Top="80" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#141413"/>
                            <Rectangle Canvas.Left="60" Canvas.Top="36" Width="13" Height="24"
                                       RadiusX="2.5" RadiusY="2.5" Fill="#141413"/>
                            <Rectangle Canvas.Left="60" Canvas.Top="64" Width="13" Height="12"
                                       RadiusX="2.5" RadiusY="2.5" Fill="#3D3B36"/>
                            <Rectangle Canvas.Left="60" Canvas.Top="80" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#E7E3D8"/>
                            <Rectangle Canvas.Left="77" Canvas.Top="36" Width="17" Height="16"
                                       RadiusX="2.5" RadiusY="2.5" Fill="#E7E3D8"/>
                            <Rectangle Canvas.Left="77" Canvas.Top="56" Width="17" Height="20"
                                       RadiusX="2.5" RadiusY="2.5" Fill="#85806F"/>
                            <Rectangle Canvas.Left="77" Canvas.Top="80" Width="17" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#3D3B36"/>
                            <Line StartPoint="72,20" EndPoint="72,94" Stroke="#D97757"
                                  StrokeThickness="3" StrokeLineCap="Round"/>
                            <Ellipse Canvas.Left="68.5" Canvas.Top="16.5" Width="7" Height="7"
                                     Fill="#D97757"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="时序" FontFamily="{StaticResource SerifFont}" FontSize="15"
                                   FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="CLASSBLOCK" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                   LetterSpacing="2" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <Border Width="1" Height="24" Background="{StaticResource LineBrush}" Margin="5,0" />
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource SerifFont}" FontSize="18"
                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                               MaxWidth="320" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="课堂应用" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="2,0,0,0" />
                </StackPanel>

                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                           HorizontalAlignment="Right">
                    <Button Classes="primary top" Content="导入总表" Click="OnImportMaster"
                            IsEnabled="{Binding IsIdle}" AutomationProperties.Name="导入总表"
                            Margin="6,2,0,2" />
                    <Button Classes="ghost top" Content="打印" Click="OnPrint"
                            IsEnabled="{Binding CanExport}" AutomationProperties.Name="打印课程表"
                            Margin="6,2,0,2" />
                    <Button Classes="ghost top" Content="导出图片" Click="OnExportImage"
                            IsEnabled="{Binding CanExport}" AutomationProperties.Name="导出课程表图片"
                            Margin="6,2,0,2" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体 ==================== -->
        <Grid Grid.Row="1" ColumnDefinitions="276,*,344" ColumnSpacing="14" Margin="16,14">
            <!-- 总表与班级 -->
            <Border Grid.Column="0" Classes="workspace-panel" Padding="14">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="9">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="section-title" Text="总表" />
                            <Border Classes="seat-tag">
                                <TextBlock Text="{Binding ClassCountLabel}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Classes="eyebrow" Text="CLASSES" />
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock Text="{Binding SourceName}" FontSize="10"
                                   Foreground="{StaticResource InkSoftBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceName}" />
                        <TextBlock Text="{Binding MasterSummary}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="9.5" LetterSpacing="0.4" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="选择下面任一班级，课程表会自动生成。" Classes="helper" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="5">
                        <Border IsVisible="{Binding HasWarnings}" Background="#FDF6F2"
                                BorderBrush="#E9C4B6" BorderThickness="1" CornerRadius="6" Padding="9,7">
                            <TextBlock Text="{Binding WarningText}" FontSize="10" LineHeight="15"
                                       Foreground="{StaticResource AccentDeepBrush}" TextWrapping="Wrap" />
                        </Border>
                        <!-- 模板损坏是老师自己的资产消失，必须持久可见（审计 P3-8）。 -->
                        <Border IsVisible="{Binding HasTemplateWarnings}" Background="#FDF6F2"
                                BorderBrush="#E9C4B6" BorderThickness="1" CornerRadius="6" Padding="9,7">
                            <TextBlock Text="{Binding TemplateWarningText}" FontSize="10" LineHeight="15"
                                       Foreground="{StaticResource AccentDeepBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <TextBox Grid.Row="3" Classes="search compact" Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="搜索班级 / 班主任"
                             AutomationProperties.Name="搜索班级或班主任" />

                    <Grid Grid.Row="4">
                        <ListBox Classes="classes" ItemsSource="{Binding FilteredClasses}"
                                 SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="app:ClassItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"
                                          AutomationProperties.Name="{Binding AutomationName}">
                                        <Border Classes="class-badge" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="9.5" Foreground="{StaticResource MutedBrush}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" FontSize="9.5"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel IsVisible="{Binding IsClassListEmpty}" Spacing="5"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ClassEmptyText}" FontFamily="{StaticResource SerifFont}"
                                       FontSize="15" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" />
                            <!-- 第二行跟着两种空态走：搜不到时说「导入总表后会出现各班」会让人以为总表丢了。 -->
                            <TextBlock Text="{Binding ClassEmptyHint}" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                            <Button Classes="link" Content="清除搜索" FontSize="10.5"
                                    Foreground="{StaticResource AccentDeepBrush}"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding HasSearchText}"
                                    Click="OnClearClassSearch" />
                            <Button Classes="primary" Content="导入总表" Click="OnImportMaster"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding !HasMaster}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="5" Text="课表会沿用总表里的节次、课服、午学与晚修信息。"
                               Classes="helper" />
                </Grid>
            </Border>

            <!-- 课程表 -->
            <Border Grid.Column="1" Classes="workspace-panel" Padding="24" ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding Preview}" Stretch="Uniform"
                           RenderOptions.BitmapInterpolationMode="HighQuality"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                    <Border IsVisible="{Binding IsEmptyState}" Classes="chart-card"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,26">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <TextBlock Text="TIMETABLE" Classes="eyebrow" HorizontalAlignment="Center" />
                            <TextBlock Text="还没有总表" FontFamily="{StaticResource SerifFont}" FontSize="24"
                                       Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="导入课程总表后，软件会自动识别年级、学期与全部班级。"
                                       Classes="helper" FontSize="11" HorizontalAlignment="Center" />
                            <Button Classes="primary top" Content="导入总表" Click="OnImportMaster"
                                    HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding IsSelectPrompt}" Classes="chart-card"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="选择一个班级" FontFamily="{StaticResource SerifFont}" FontSize="22"
                                       Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="从左侧班级列表里选中目标班级，课程表会立即出现在这里。"
                                       Classes="helper" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 设置（与归位一致：无卡套卡，section + hairline） -->
            <Border Grid.Column="2" Classes="workspace-panel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Classes="inspector-section">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-title" Text="作息模板" />
                                    <TextBlock Grid.Column="1" Classes="eyebrow" Text="TEMPLATE" />
                                </Grid>
                                <ComboBox Classes="field" ItemsSource="{Binding Templates}"
                                          SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                          AutomationProperties.Name="作息模板">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="ct:TimetableTemplate">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="模板决定课表的行序与时间，导入总表后按年级自动套用。"
                                           Classes="helper" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <Button Grid.Column="0" Classes="ghost tool" Content="编辑模板" Click="OnEditTemplate"
                                            AutomationProperties.Name="编辑作息模板" />
                                    <Button Grid.Column="1" Classes="ghost tool" Content="新建模板" Click="OnNewTemplate"
                                            AutomationProperties.Name="新建作息模板" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="inspector-divider" />

                        <Border Classes="inspector-section">
                            <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-title" Text="课程表标题" />
                                    <TextBlock Grid.Column="1" Classes="eyebrow" Text="TITLE" />
                                </Grid>
                                <TextBox Classes="field" Text="{Binding Title, Mode=TwoWay}"
                                         PlaceholderText="例如：九（6）班课程表" />
                                <TextBlock Text="{Binding Subtitle}" Classes="helper" />
                                <CheckBox IsChecked="{Binding ShowTeachers, Mode=TwoWay}"
                                          Content="在课程格里显示任课教师" FontSize="11.5" />
                                <TextBlock Text="关闭时只显示学科，版式与打印出来的课表一致。"
                                           Classes="toggle-note" Margin="26,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Classes="inspector-divider" />

                        <Border Classes="inspector-section">
                            <StackPanel Spacing="7">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                    <TextBlock Classes="section-title" Text="显示内容" />
                                    <TextBlock Grid.Column="1" Classes="eyebrow" Text="DISPLAY" />
                                </Grid>
                                <CheckBox IsChecked="{Binding ShowEarlyReading, Mode=TwoWay}"
                                          Content="早读" FontSize="11.5" />
                                <CheckBox IsChecked="{Binding ShowLunchStudy, Mode=TwoWay}"
                                          Content="午学" FontSize="11.5" />
                                <CheckBox IsChecked="{Binding ShowAfterSchool, Mode=TwoWay}"
                                          Content="课后服务" FontSize="11.5" />
                                <CheckBox IsChecked="{Binding ShowEveningStudy, Mode=TwoWay}"
                                          Content="新闻联播与晚修" FontSize="11.5" />
                                <TextBlock Text="大课间、午餐与晚餐是固定休息行，始终保留。"
                                           Classes="helper" />
                            </StackPanel>
                        </Border>

                        <Border Classes="inspector-divider" />

                        <Border Classes="inspector-section">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-title" Text="识别结果" />
                                    <TextBlock Grid.Column="1" Classes="eyebrow" Text="DETECTED" />
                                </Grid>
                                <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      RowSpacing="6">
                                    <TextBlock Classes="field-label" Text="年级" />
                                    <TextBlock Grid.Column="1" Text="{Binding GradeText}" FontSize="11"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Grid.Row="1" Classes="field-label" Text="学期" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TermText}" FontSize="11"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Grid.Row="2" Classes="field-label" Text="月份" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MonthText}" FontSize="11"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Grid.Row="3" Classes="field-label" Text="课程表" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SheetText}" FontSize="11"
                                               Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Grid.Row="4" Classes="field-label" Text="班级数" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ClassCountLabel}"
                                               FontSize="11" Foreground="{StaticResource InkBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="inspector-divider" />

                        <Border Classes="inspector-section">
                            <Border Classes="chart-card">
                                <StackPanel Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="总表怎么认" Classes="subhead" />
                                        <TextBlock Grid.Column="1" Text="TIPS" Classes="eyebrow" />
                                    </Grid>
                                    <TextBlock Text="软件会寻找同时包含「星期一…星期五」「1—7 节」和班级行的课程表，并从同一份工作簿里读取班主任、午学、课服与晚修。"
                                               Classes="helper" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="2" Classes="app-statusbar">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="760"
                               ToolTip.Tip="{Binding StatusText}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding MasterSummary}"
                           FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="LOCAL ONLY · 本机处理"
                           FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                           LetterSpacing="0.8" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ==================== 忙碌遮罩 ====================
             导入总表 / 打印 PDF / 导出 PNG 都要持续几百毫秒到几秒。没有可见反馈时，
             老师会以为程序卡死并强关（强关会丢掉正在写的文件）。
             400ms 后才亮：小总表瞬间完成，一闪而过的遮罩比不动更晃眼。 -->
        <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding ShowBusyOverlay}"
                Classes="busy-overlay" ZIndex="60">
            <Border Classes="busy-card"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="420">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding BusyTitle}" FontFamily="{StaticResource SerifFont}"
                               FontSize="17" Foreground="{StaticResource InkBrush}"
                               TextWrapping="Wrap" HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="240" Height="3" />
                    <TextBlock Text="{Binding BusyDetail}" FontSize="10" LineHeight="16"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="处理期间请勿关闭窗口" FontFamily="{StaticResource MonoFont}"
                               FontSize="9" LetterSpacing="0.8"
                               Foreground="{StaticResource LineStrongBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
