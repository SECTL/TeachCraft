<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:SeatGrid.App"
        xmlns:controls="using:SeatGrid.App.Controls"
        x:Class="SeatGrid.App.SeatGridWindow"
        x:DataType="app:SeatGridViewModel"
        Title="归位 · SeatGrid"
        Width="1440" Height="920"
        MinWidth="1180" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PaperBrush}">
    <Design.DataContext>
        <app:SeatGridViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <!-- 右侧设置面板：一张白卡内按节排布，节间用内缩细线分隔，不再卡中套卡 -->
        <Style Selector="Border.inspector-section">
            <Setter Property="Padding" Value="16,14,16,16" />
        </Style>
        <Style Selector="Border.inspector-divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="LetterSpacing" Value="1.4" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.subhead">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
        </Style>
        <!-- 复选框下的说明与复选框文字左对齐：20px 方框 + 8px 间距 -->
        <Style Selector="TextBlock.toggle-note">
            <Setter Property="Margin" Value="28,-5,0,4" />
        </Style>
        <!-- 面板内按钮等分铺满所在列；纵向拉伸让无边框的 primary 与 1px 边的 ghost 同高 -->
        <Style Selector="Button.tool">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="Path.shift-icon">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{StaticResource InkSoftBrush}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="StackPanel.swatch">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="8" />
        </Style>
        <Style Selector="StackPanel.swatch > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 视角分段控件：浅槽 + 白色选中块，两段等分 -->
        <Style Selector="Border.segmented">
            <Setter Property="Background" Value="{StaticResource PaperDeepBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style Selector="Button.segment">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource WashBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.segment.active">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- 选中块放在悬停样式之后：悬停在已选中的一段上仍保持白底，不像被取消选中 -->
        <Style Selector="Button.segment.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.segment:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource WashDeepBrush}" />
        </Style>
        <Style Selector="Border.chart-card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="LetterSpacing" Value="0.4" />
        </Style>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="#FCFBF7" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style Selector="ComboBox.field">
            <Setter Property="Background" Value="#FCFBF7" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style Selector="Button.top">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="Button.mode">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.mode.active">
            <Setter Property="Background" Value="#F1EEE5" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#D6D1C4" />
        </Style>
        <Style Selector="Button.mode:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F7F4EB" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Button.accent-outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
            <Setter Property="BorderBrush" Value="#E9C4B6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.accent-outline /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
        </Style>
        <Style Selector="Button.accent-outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FBEDE7" />
            <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
        </Style>
        <Style Selector="Button.accent-outline:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F7E0D6" />
            <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
        </Style>
        <Style Selector="Button.accent-outline:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8A8474" />
            <Setter Property="BorderBrush" Value="#E7E3D8" />
        </Style>
        <Style Selector="ListBox.roster">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.roster ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="ListBox.roster ListBoxItem:pointerover">
            <Setter Property="Background" Value="#F7F4EB" />
        </Style>
        <Style Selector="ListBox.roster ListBoxItem:selected">
            <Setter Property="Background" Value="#F1EEE5" />
        </Style>
        <Style Selector="Border.seat-tag">
            <Setter Property="Background" Value="#F7F4EB" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,1" />
        </Style>
        <Style Selector="Border.seat-tag.assigned">
            <Setter Property="Background" Value="#FBEDE7" />
            <Setter Property="BorderBrush" Value="#E9C4B6" />
        </Style>
        <Style Selector="Button.seat-cell">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border Name="SeatSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center" />
                        </Border>
                        <Rectangle Name="SeatDashed" Margin="1" RadiusX="5" RadiusY="5"
                                   Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"
                                   StrokeDashArray="4,3"
                                   IsVisible="{ReflectionBinding ShowEmptyFrame}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.seat-cell:pointerover /template/ Border#SeatSurface">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="Button.seat-cell.selected /template/ Border#SeatSurface">
            <Setter Property="BorderBrush" Value="{StaticResource AccentDeepBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.line-handle">
            <Setter Property="Background" Value="#FBEDE7" />
            <Setter Property="Foreground" Value="{StaticResource AccentDeepBrush}" />
            <Setter Property="BorderBrush" Value="#E9C4B6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.line-handle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F7E0D6" />
        </Style>
        <Style Selector="Button.line-handle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F2D3C6" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ==================== 顶栏 ==================== -->
        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Viewbox Width="38" Height="38">
                        <Canvas Width="120" Height="120">
                            <Rectangle Canvas.Left="10" Canvas.Top="10" Width="100" Height="100"
                                       RadiusX="24" RadiusY="24" Fill="#FAF9F5"
                                       Stroke="#E7E3D8" StrokeThickness="3"/>
                            <Rectangle Canvas.Left="38" Canvas.Top="26" Width="44" Height="9"
                                       RadiusX="2.5" RadiusY="2.5" Fill="#141413"/>
                            <Rectangle Canvas.Left="26" Canvas.Top="42" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#3D3B36"/>
                            <Rectangle Canvas.Left="42" Canvas.Top="42" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#E7E3D8"/>
                            <Rectangle Canvas.Left="65" Canvas.Top="42" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#85806F"/>
                            <Rectangle Canvas.Left="81" Canvas.Top="42" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#141413"/>
                            <Rectangle Canvas.Left="26" Canvas.Top="58" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#85806F"/>
                            <Rectangle Canvas.Left="42" Canvas.Top="58" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#D97757"/>
                            <Rectangle Canvas.Left="65" Canvas.Top="58" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#E7E3D8"/>
                            <Rectangle Canvas.Left="81" Canvas.Top="58" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#3D3B36"/>
                            <Rectangle Canvas.Left="26" Canvas.Top="74" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#141413"/>
                            <Rectangle Canvas.Left="42" Canvas.Top="74" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#E7E3D8"/>
                            <Rectangle Canvas.Left="65" Canvas.Top="74" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#3D3B36"/>
                            <Rectangle Canvas.Left="81" Canvas.Top="74" Width="13" Height="10"
                                       RadiusX="2" RadiusY="2" Fill="#85806F"/>
                            <Line StartPoint="57.5,20" EndPoint="57.5,92" Stroke="#D97757"
                                  StrokeThickness="3" StrokeLineCap="Round"/>
                            <Ellipse Canvas.Left="54" Canvas.Top="16.5" Width="7" Height="7"
                                     Fill="#D97757"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="归位" FontFamily="{StaticResource SerifFont}" FontSize="19"
                                   LetterSpacing="3" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="SEATGRID" FontFamily="{StaticResource MonoFont}" FontSize="8"
                                   LetterSpacing="2.2" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <Border Width="1" Height="30" Background="{StaticResource LineBrush}" Margin="7,0" />
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource SerifFont}" FontSize="22"
                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center"
                               MaxWidth="280" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="课堂应用" FontSize="9.5" LetterSpacing="1"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="primary top" Content="导入名单" Click="OnImportRoster"
                            IsEnabled="{Binding IsIdle}" AutomationProperties.Name="导入名单" />
                    <TextBlock Text="排座方式" Classes="field-label" VerticalAlignment="Center" />
                    <ComboBox Classes="field" Width="104" ItemsSource="{Binding ArrangeModes}"
                              SelectedIndex="{Binding ArrangeModeIndex, Mode=TwoWay}"
                              ToolTip.Tip="自动排座方式" />
                    <Button Classes="accent-outline top" Content="自动排座" Click="OnAutoArrange"
                            IsEnabled="{Binding CanArrange}" AutomationProperties.Name="自动排座" />
                    <Button Classes="ghost top" Content="预览" Click="OnPreview"
                            IsEnabled="{Binding CanExport}" />
                    <Button Classes="ghost top" Content="打印" Click="OnPrint"
                            IsEnabled="{Binding CanExport}" />
                    <Button Classes="ghost top" Content="导出图片" Click="OnExportImage"
                            IsEnabled="{Binding CanExport}" />
                    <Button Classes="ghost top" Content="导出 Excel" Click="OnExportExcel"
                            IsEnabled="{Binding CanExport}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体 ==================== -->
        <Grid Grid.Row="1" ColumnDefinitions="264,*,352" ColumnSpacing="14" Margin="16,14">
            <!-- 名单 -->
            <Border Grid.Column="0" Classes="panel" Padding="13">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="名单" FontFamily="{StaticResource SerifFont}" FontSize="17"
                                       Foreground="{StaticResource InkBrush}" />
                            <Border Classes="chip" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StudentCount}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="9.5" Foreground="#6B6557" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ImportSource}" FontSize="9"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                   MaxWidth="118" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding ImportSource}" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding RosterStats}" FontFamily="{StaticResource MonoFont}"
                               FontSize="9.5" LetterSpacing="0.5" Foreground="{StaticResource MutedBrush}" />

                    <TextBox Grid.Row="2" Classes="search" Text="{Binding SearchText, Mode=TwoWay}"
                             PlaceholderText="搜索姓名 / 学号 / 小组"
                             AutomationProperties.Name="搜索学生姓名、学号或小组" />

                    <Grid Grid.Row="3">
                        <ListBox Classes="roster" ItemsSource="{Binding FilteredStudents}"
                                 SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="app:StudentViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                          AutomationProperties.Name="{Binding Name}">
                                        <Ellipse Width="6" Height="6" Fill="{Binding GenderBrush}"
                                                 VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Meta}" FontSize="9.5"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="seat-tag"
                                                Classes.assigned="{Binding IsAssigned}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SeatLabel}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="8.5" Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel IsVisible="{Binding IsRosterEmpty}" Spacing="5"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RosterEmptyText}" FontFamily="{StaticResource SerifFont}"
                                       FontSize="15" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="导入名单后，这里会出现学生。" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="4" Background="#F8F6F0" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="10,9">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding SelectedSeatLabel}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9.5" Foreground="{StaticResource AccentDeepBrush}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                                <Button Classes="primary" Content="放入所选学生" Padding="8,5" FontSize="10.5"
                                        Click="OnAssign" IsEnabled="{Binding CanAssign}" />
                                <Button Grid.Column="1" Classes="ghost" Content="清空座位" Padding="8,5"
                                        FontSize="10.5" Click="OnClearSeat" IsEnabled="{Binding CanClearSeat}" />
                            </Grid>
                            <TextBlock Text="先点座位，再选左侧学生，最后点「放入」。"
                                       Classes="helper" />
                        </StackPanel>
                    </Border>

                    <Expander Grid.Row="5" Header="{Binding EditPanelTitle}" HorizontalAlignment="Stretch"
                              FontSize="11" IsExpanded="False">
                        <StackPanel Spacing="7" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <TextBox Classes="field" Text="{Binding EditName, Mode=TwoWay}" PlaceholderText="姓名" />
                                <TextBox Grid.Column="1" Classes="field" Text="{Binding EditNumber, Mode=TwoWay}" PlaceholderText="学号" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <ComboBox Classes="field" ItemsSource="{Binding GenderOptions}"
                                          SelectedIndex="{Binding EditGenderIndex, Mode=TwoWay}" />
                                <TextBox Grid.Column="1" Classes="field" Text="{Binding EditHeight, Mode=TwoWay}"
                                         PlaceholderText="身高 cm" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                <TextBox Classes="field" Text="{Binding EditVision, Mode=TwoWay}" PlaceholderText="视力" />
                                <TextBox Grid.Column="1" Classes="field" Text="{Binding EditNotes, Mode=TwoWay}"
                                         PlaceholderText="备注" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="primary" Content="保存修改" Padding="10,5" FontSize="10.5"
                                        Click="OnApplyStudent" IsVisible="{Binding HasSelectedStudent}" />
                                <Button Classes="ghost" Content="删除" Padding="10,5" FontSize="10.5"
                                        Click="OnDeleteStudent" IsVisible="{Binding HasSelectedStudent}" />
                                <Button Classes="primary" Content="+ 新增学生" Padding="10,5" FontSize="10.5"
                                        Click="OnAddStudent" IsVisible="{Binding !HasSelectedStudent}" />
                            </StackPanel>
                            <TextBlock Text="未选中学生时，这里填好后点「新增学生」直接加入名单；选中名单里的学生后可以修改或删除。"
                                       Classes="helper" IsVisible="{Binding !HasSelectedStudent}" />
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>

            <!-- 座位表 -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="9">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="mode" Classes.active="{Binding IsTeacherView}"
                                Content="教师视角" Click="OnTeacherView" />
                        <Button Classes="mode" Classes.active="{Binding IsStudentView}"
                                Content="学生视角" Click="OnStudentView" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="按住学生卡片拖到另一座位即交换（空位则移动）；行首、列尾把手可整排整列对调。"
                               FontSize="9.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Classes="chip" IsVisible="{Binding ShowGenderLegend}" VerticalAlignment="Center"
                                ToolTip.Tip="座位表中男 / 女生姓名所用的颜色">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6" Height="6" Fill="{Binding SeatTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="男" FontSize="9.5" Foreground="{Binding SeatTextBrush}"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="6" Height="6" Fill="{Binding FemaleMarkBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="女" FontSize="9.5" Foreground="{Binding FemaleMarkBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Classes="chip" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SeatStats}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9.5" Foreground="#6B6557" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Classes="chart-card" x:Name="SeatChartHost">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource SerifFont}"
                                           FontSize="22" FontWeight="{Binding TitleWeight}"
                                           Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding InfoLine}" FontSize="10.5"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                           Margin="0,3,0,10" />

                                <Border IsVisible="{Binding PodiumOnTop}" Width="{Binding PodiumWidth}"
                                        Height="40" Margin="{Binding PodiumTopMargin}"
                                        HorizontalAlignment="Center" Background="{Binding PodiumBackgroundBrush}"
                                        BorderBrush="{Binding SeatBorderBrush}" BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock Text="讲　台" FontSize="11.5" Foreground="{Binding PodiumTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <ItemsControl ItemsSource="{Binding Groups}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="22" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="app:GroupViewModel">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}"
                                                           IsVisible="{Binding ShowHints}"
                                                           Margin="{Binding LabelMargin}"
                                                           Foreground="{Binding LabelBrush}" FontSize="9.5"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="app:RowViewModel">
                                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                                        Margin="0,0,0,6">
                                                                <Border Width="44" IsVisible="{Binding ShowHandle}">
                                                                    <Button Classes="line-handle" Tag="{Binding}"
                                                                            Width="30" Height="20"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Content="{Binding Number}"
                                                                            FontFamily="{StaticResource MonoFont}"
                                                                            ToolTip.Tip="按住拖动：与目标排整排对调"
                                                                            AutomationProperties.Name="{Binding AutomationName}" />
                                                                </Border>
                                                                <ItemsControl ItemsSource="{Binding Seats}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="app:SeatCellViewModel">
                                                                            <Button Classes="seat-cell"
                                                                                    Classes.selected="{Binding IsSelected}"
                                                                                    Width="{Binding Width}"
                                                                                    Height="{Binding Height}"
                                                                                    Background="{Binding Fill}"
                                                                                    BorderBrush="{Binding Stroke}"
                                                                                    BorderThickness="{Binding BorderThickness}"
                                                                                    Foreground="{Binding NameBrush}"
                                                                                    Tag="{Binding}"
                                                                                    Click="OnSeatClick"
                                                                                    ToolTip.Tip="{Binding PositionLabel}"
                                                                                    AutomationProperties.Name="{Binding AutomationName}">
                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                           FontSize="{Binding FontSize}"
                                                                                           FontWeight="{Binding FontWeight}"
                                                                                           Foreground="{Binding NameBrush}"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center" />
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Grid ColumnDefinitions="Auto,*" Margin="0,3,0,0">
                                                    <Border Grid.Column="0" Width="44"
                                                            IsVisible="{Binding ShowRowSpacer}" />
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding ColumnHandles}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="app:ColumnHandleViewModel">
                                                                <Button Classes="line-handle" Tag="{Binding}"
                                                                        Width="{Binding Width}" Height="16"
                                                                        CornerRadius="4" FontSize="10"
                                                                        Content="⠿"
                                                                        ToolTip.Tip="按住拖动：与目标列整列对调"
                                                                        AutomationProperties.Name="{Binding AutomationName}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border IsVisible="{Binding PodiumOnBottom}" Width="{Binding PodiumWidth}"
                                        Height="40" Margin="{Binding PodiumBottomMargin}"
                                        HorizontalAlignment="Center" Background="{Binding PodiumBackgroundBrush}"
                                        BorderBrush="{Binding SeatBorderBrush}" BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock Text="讲　台" FontSize="11.5" Foreground="{Binding PodiumTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border IsVisible="{Binding IsChartEmpty}" Background="#F2FAF9F5"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="还没有名单" FontFamily="{StaticResource SerifFont}" FontSize="26"
                                           Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="导入 Excel / CSV 名单，软件会自动识别姓名、性别、身高与视力。"
                                           FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="之前「导出 Excel」的座位表也能直接导入，接着修改。"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,-4,0,0" />
                                <Button Classes="primary" Content="导入名单" Click="OnImportRoster"
                                        HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 设置 -->
            <Border Grid.Column="2" Classes="panel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsContent">
                        <!-- 座位布局 -->
                        <Border Classes="inspector-section">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-title" Text="座位布局" />
                                    <TextBlock Grid.Column="1" Classes="eyebrow" Text="LAYOUT" />
                                </Grid>
                                <StackPanel Spacing="6">
                                    <Border Classes="segmented">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                                            <Button Classes="segment" Classes.active="{Binding IsTeacherView}"
                                                    Content="教师视角" Click="OnTeacherView" />
                                            <Button Grid.Column="1" Classes="segment" Classes.active="{Binding IsStudentView}"
                                                    Content="学生视角" Click="OnStudentView" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Classes="helper"
                                               Text="教师视角讲台在下，适合打印给教师；学生视角讲台在上。" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="field-label" Text="小组数量" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding GroupCountLabel}" Classes="numeral" FontSize="11" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding GroupCount, Mode=TwoWay}" AutomationProperties.Name="小组数量" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="field-label" Text="每组排数" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding RowCountLabel}" Classes="numeral" FontSize="11" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding RowCount, Mode=TwoWay}" AutomationProperties.Name="每组排数" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="field-label" Text="每组人数（列）" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ColumnCountLabel}" Classes="numeral" FontSize="11" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding ColumnCount, Mode=TwoWay}" AutomationProperties.Name="每组人数（列）" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="field-label" Text="格子大小" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding CellSizeLabel}" Classes="numeral" FontSize="11" />
                                    </Grid>
                                    <Slider Minimum="50" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding CellScale, Mode=TwoWay}" AutomationProperties.Name="格子大小" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Classes="inspector-divider" />

                        <!-- 行列调整 -->
                        <Border Classes="inspector-section">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-title" Text="调整行列" />
                                    <TextBlock Grid.Column="1" Classes="eyebrow" Text="SHIFT" />
                                </Grid>
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="field-label" Text="整班平移一格" />
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                        <Button Classes="ghost tool" Click="OnShiftLeft"
                                                ToolTip.Tip="整班向左平移一格" AutomationProperties.Name="全部向左平移">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Path Classes="shift-icon" Data="M9,5 L1,5 M4.5,1.5 L1,5 L4.5,8.5" />
                                                <TextBlock Text="左移" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Classes="ghost tool" Click="OnShiftRight"
                                                ToolTip.Tip="整班向右平移一格" AutomationProperties.Name="全部向右平移">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Path Classes="shift-icon" Data="M1,5 L9,5 M5.5,1.5 L9,5 L5.5,8.5" />
                                                <TextBlock Text="右移" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Classes="ghost tool" Click="OnShiftUp"
                                                ToolTip.Tip="整班向上平移一格" AutomationProperties.Name="全部向上平移">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Path Classes="shift-icon" Data="M5,9 L5,1 M1.5,4.5 L5,1 L8.5,4.5" />
                                                <TextBlock Text="上移" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Classes="ghost tool" Click="OnShiftDown"
                                                ToolTip.Tip="整班向下平移一格" AutomationProperties.Name="全部向下平移">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Path Classes="shift-icon" Data="M5,1 L5,9 M1.5,5.5 L5,9 L8.5,5.5" />
                                                <TextBlock Text="下移" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Classes="helper"
                                           Text="方向按当前视角计算，超出边缘自动绕回。行首排号与列尾 ⠿ 把手可按住拖动，与目标整排 / 整列对调。" />
                            </StackPanel>
                        </Border>
                        <Border Classes="inspector-divider" />

                        <!-- 标题 -->
                        <Border Classes="inspector-section">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-title" Text="标题与信息" />
                                    <TextBlock Grid.Column="1" Classes="eyebrow" Text="TITLE" />
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="field-label" Text="座位表标题" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Classes="field" Text="{Binding Title, Mode=TwoWay}"
                                                 PlaceholderText="例如：九年级六班座位表"
                                                 AutomationProperties.Name="座位表标题" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding BoldTitle, Mode=TwoWay}"
                                                  Content="加粗" MinWidth="0" VerticalAlignment="Center"
                                                  ToolTip.Tip="座位表标题加粗" AutomationProperties.Name="标题加粗" />
                                    </Grid>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="field-label" Text="班主任" />
                                        <TextBox Classes="field" Text="{Binding HeadTeacher, Mode=TwoWay}"
                                                 PlaceholderText="可选" AutomationProperties.Name="班主任" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Classes="field-label" Text="班长" />
                                        <TextBox Classes="field" Text="{Binding Monitor, Mode=TwoWay}"
                                                 PlaceholderText="可选" AutomationProperties.Name="班长" />
                                    </StackPanel>
                                </Grid>
                                <!-- 信息行预览：与座位表标题下的那一行同源 -->
                                <Border Background="{StaticResource WashBrush}" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,7">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Classes="field-label" Text="信息行" />
                                        <TextBlock Grid.Column="1" Text="{Binding InfoLine}" FontSize="10.5"
                                                   Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                                <TextBlock Classes="helper" Text="人数按名单自动统计；班主任、班长留空则不显示。" />
                            </StackPanel>
                        </Border>
                        <Border Classes="inspector-divider" />

                        <!-- 样式：「恢复默认」覆盖本节全部（文字、显示、配色），不动布局、标题与名单 -->
                        <Border Classes="inspector-section">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-title" Text="座位表样式" />
                                    <Button Grid.Column="1" Classes="link" Content="恢复默认" Click="OnResetStyle"
                                            FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                            ToolTip.Tip="恢复本节的文字、显示与配色默认值；不改动布局、标题与名单"
                                            AutomationProperties.Name="恢复座位表样式默认值" />
                                </Grid>
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="subhead" Text="文字" />
                                    <StackPanel Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="field-label" Text="名字字体大小" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding NameFontSizeLabel}" Classes="numeral" FontSize="11" />
                                        </Grid>
                                        <Slider Minimum="10" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding NameFontSize, Mode=TwoWay}" AutomationProperties.Name="名字字体大小" />
                                    </StackPanel>
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding BoldNames, Mode=TwoWay}" Content="名字加粗" />
                                        <CheckBox IsChecked="{Binding SpaceTwoCharNames, Mode=TwoWay}" Content="两字姓名自动加空格" />
                                        <CheckBox IsChecked="{Binding MarkFemales, Mode=TwoWay}" Content="标记女生" />
                                        <TextBlock Classes="helper toggle-note"
                                                   Text="女生姓名改用「女生标记」颜色；关闭则统一用姓名颜色。" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="8" Margin="0,4,0,0">
                                    <TextBlock Classes="subhead" Text="显示" />
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding HideEmptySeats, Mode=TwoWay}" Content="隐藏空座位" />
                                        <TextBlock Classes="helper toggle-note" Text="未安排学生的座位不再画虚线框。" />
                                        <CheckBox IsChecked="{Binding ShowGroupRowHints, Mode=TwoWay}" Content="显示组排提示" />
                                        <TextBlock Classes="helper toggle-note"
                                                   Text="关闭后隐藏「第几组」标题；行首排号把手仍保留，用于拖动整排。" />
                                    </StackPanel>
                                    <StackPanel Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Classes="field-label" Text="讲台与座位距离" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding PodiumGapLabel}" Classes="numeral" FontSize="11" />
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding PodiumGap, Mode=TwoWay}" AutomationProperties.Name="讲台与座位距离" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="8" Margin="0,4,0,0">
                                    <TextBlock Classes="subhead" Text="配色" />
                                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto"
                                          ColumnSpacing="8" RowSpacing="8">
                                        <StackPanel Classes="swatch">
                                            <controls:ColorSwatchButton Width="28" HorizontalAlignment="Left"
                                                Color="{Binding SeatBackgroundColor, Mode=TwoWay}" AutomationProperties.Name="座位背景颜色" />
                                            <TextBlock Text="座位背景" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Classes="swatch">
                                            <controls:ColorSwatchButton Width="28" HorizontalAlignment="Left"
                                                Color="{Binding EmptySeatColor, Mode=TwoWay}" AutomationProperties.Name="空位背景颜色" />
                                            <TextBlock Text="空位背景" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Classes="swatch">
                                            <controls:ColorSwatchButton Width="28" HorizontalAlignment="Left"
                                                Color="{Binding SeatBorderColor, Mode=TwoWay}" AutomationProperties.Name="座位边框颜色" />
                                            <TextBlock Text="边框颜色" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Classes="swatch">
                                            <controls:ColorSwatchButton Width="28" HorizontalAlignment="Left"
                                                Color="{Binding SeatTextColor, Mode=TwoWay}" AutomationProperties.Name="姓名颜色" />
                                            <TextBlock Text="姓名颜色" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Classes="swatch">
                                            <controls:ColorSwatchButton Width="28" HorizontalAlignment="Left"
                                                Color="{Binding FemaleMarkColor, Mode=TwoWay}" AutomationProperties.Name="女生标记颜色" />
                                            <TextBlock Text="女生标记" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Classes="swatch">
                                            <controls:ColorSwatchButton Width="28" HorizontalAlignment="Left"
                                                Color="{Binding GroupLabelColor, Mode=TwoWay}" AutomationProperties.Name="组标题颜色" />
                                            <TextBlock Text="组标题" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Classes="swatch">
                                            <controls:ColorSwatchButton Width="28" HorizontalAlignment="Left"
                                                Color="{Binding RowLabelColor, Mode=TwoWay}" AutomationProperties.Name="排标题颜色" />
                                            <TextBlock Text="排标题" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Classes="swatch">
                                            <controls:ColorSwatchButton Width="28" HorizontalAlignment="Left"
                                                Color="{Binding PodiumBackgroundColor, Mode=TwoWay}" AutomationProperties.Name="讲台底色" />
                                            <TextBlock Text="讲台底色" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2" Classes="swatch">
                                            <controls:ColorSwatchButton Width="28" HorizontalAlignment="Left"
                                                Color="{Binding PodiumTextColor, Mode=TwoWay}" AutomationProperties.Name="讲台文字颜色" />
                                            <TextBlock Text="讲台文字" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Classes="inspector-divider" />

                        <!-- 配置 -->
                        <Border Classes="inspector-section">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="section-title" Text="Excel 配置" />
                                    <TextBlock Grid.Column="1" Classes="eyebrow" Text="CONFIG" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Classes="primary tool" Content="导出配置"
                                            Click="OnExportConfig" IsEnabled="{Binding IsIdle}" />
                                    <Button Grid.Column="1" Classes="ghost tool" Content="导入配置"
                                            Click="OnImportConfig" IsEnabled="{Binding IsIdle}" />
                                </Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="helper" Text="配置文件包含座位设置、名单与座位位置；「导出 Excel」的座位表同样能导回。导入会覆盖当前状态。" />
                                    <TextBlock Classes="helper" Foreground="{StaticResource AccentDeepBrush}"
                                               Text="请勿修改导出的配置表格结构，否则可能无法导入。" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="18,9">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="760" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SeatStats}"
                           FontFamily="{StaticResource MonoFont}" FontSize="9"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="LOCAL ONLY · 名单不上传"
                           FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                           LetterSpacing="1.2" Foreground="{StaticResource MossBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 拖拽浮层：跟手的学生名卡 -->
        <Canvas Name="DragLayer" Grid.RowSpan="3" IsHitTestVisible="False" ZIndex="99" />
    </Grid>
</Window>

