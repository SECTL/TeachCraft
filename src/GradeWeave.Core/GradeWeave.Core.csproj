<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NPOI 构建期检查：确认接受其捆绑的开源组件许可后才能引入。 -->
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="NPOI" Version="2.8.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>

  <!-- 希沃全校课表导入模板：希沃官方下发的空表，随程序内置，
       导出「希沃全校课表」时直接拿它当底板（批注、表头、合并与样式原样保留）。 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\希沃全校课表模板.xlsx" LogicalName="GradeWeave.SeewoTemplate.xlsx" />
  </ItemGroup>

</Project>
