<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:GradeWeave.App"
        x:Class="GradeWeave.App.ExportOptionsWindow"
        x:DataType="app:ExportOptionsViewModel"
        Title="导出课表"
        Width="1040" Height="760"
        MinWidth="880" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}">
    <Window.Styles>
        <Style Selector="CheckBox.sheet">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Classes="dialog-header">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                    <TextBlock Text="导出课表" Classes="section-title" FontSize="18" />
                    <TextBlock Text="{Binding ProjectTitle}" Classes="helper" FontSize="11" />
                    <TextBlock Text="{Binding Summary}" Classes="helper" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="EXPORT" Classes="eyebrow" />
            </Grid>
        </Border>

        <!-- 左：设置　右：预览 -->
        <Grid Grid.Row="1" ColumnDefinitions="420,*" ColumnSpacing="14" Margin="16,14">
            <Border Grid.Column="0" Classes="workspace-panel">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Classes="inspector-section">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="导出选项" Classes="section-title" />
                                    <TextBlock Grid.Column="1" Text="OPTIONS" Classes="eyebrow" />
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="field-label" Text="导出格式" />
                                    <ComboBox Classes="field" ItemsSource="{Binding Formats}"
                                              SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                                              AutomationProperties.Name="导出格式">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="app:ExportFormatOption">
                                                <StackPanel Spacing="1" Margin="0,2">
                                                    <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                               Foreground="{StaticResource InkBrush}" />
                                                    <TextBlock Text="{Binding Hint}" FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="6" IsVisible="{Binding IsExcel}">
                                    <TextBlock Classes="field-label" Text="Excel 样式" />
                                    <ComboBox Classes="field" ItemsSource="{Binding Styles}"
                                              SelectedItem="{Binding SelectedStyle, Mode=TwoWay}"
                                              AutomationProperties.Name="Excel 样式">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="app:ExportStyleOption">
                                                <StackPanel Spacing="1" Margin="0,2">
                                                    <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                               Foreground="{StaticResource InkBrush}" />
                                                    <TextBlock Text="{Binding Hint}" FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Classes="helper" Text="{Binding StyleHint}" />

                                    <StackPanel Spacing="4" IsVisible="{Binding ShowReferenceName}">
                                        <TextBlock Classes="field-label" Text="本机样式名称" />
                                        <TextBox Classes="field" Text="{Binding ReferenceStyleName, Mode=TwoWay}"
                                                 PlaceholderText="例如：软件自带样式2" />
                                        <TextBlock Classes="helper"
                                                   Text="名称只保存在本机，不写入导出文件、工程或仓库。" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Classes="chart-card" IsVisible="{Binding ShowSheetChoices}">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="包含分页" Classes="subhead" />
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                            <CheckBox Classes="sheet" Content="课程表总表"
                                                      IsChecked="{Binding IncludeMaster, Mode=TwoWay}" />
                                            <CheckBox Grid.Column="1" Classes="sheet" Content="教师分工表"
                                                      IsChecked="{Binding IncludeAssignment, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="1" Classes="sheet" Content="教师职位安排表"
                                                      IsChecked="{Binding IncludeTeacherPosition, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="1" Grid.Column="1" Classes="sheet" Content="班级课表"
                                                      IsChecked="{Binding IncludeClassSheets, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="2" Classes="sheet" Content="教师课表"
                                                      IsChecked="{Binding IncludeTeacherSheets, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="2" Grid.Column="1" Classes="sheet" Content="冲突页"
                                                      IsChecked="{Binding IncludeConflict, Mode=TwoWay}" />
                                        </Grid>
                                        <TextBlock Classes="helper"
                                                   Text="软件自带样式2按参考工作簿生成表一分工表、表二横向课程总表和表三教师职位表；软件自带样式沿用纸墨版式。" />
                                    </StackPanel>
                                </Border>

                                <!-- 希沃预设：只有一张表，分页勾选不生效，说明清楚为什么 -->
                                <Border Classes="chart-card"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        Background="{StaticResource WashHoverBrush}"
                                        IsVisible="{Binding IsSeewoStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="希沃预设" Classes="subhead" />
                                        <TextBlock Classes="helper"
                                                   Text="希沃模板只有一张「班级课表计划」表，所以这里没有分页可选。导出的文件保留了模板自带的标题、填写须知、表头批注与合并单元格，只把示例行换成你的课表——可以直接上传希沃平台。" />
                                        <TextBlock Classes="helper"
                                                   Text="课节按工程的作息时间表编号（第 1 节…第 N 节）；课后服务与晚修不进希沃模板。" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Spacing="6" IsVisible="{Binding IsImageOrPdf}">
                                    <TextBlock Classes="field-label" Text="导出对象" />
                                    <ComboBox Classes="field"
                                              ItemsSource="{Binding ClassTargets}"
                                              SelectedItem="{Binding SelectedClassTarget, Mode=TwoWay}"
                                              AutomationProperties.Name="选择导出班级" />
                                    <ComboBox Classes="field"
                                              ItemsSource="{Binding TeacherTargets}"
                                              SelectedItem="{Binding SelectedTeacherTarget, Mode=TwoWay}"
                                              AutomationProperties.Name="选择导出教师" />
                                    <TextBlock Classes="helper" Text="{Binding TargetHint}" />
                                </StackPanel>

                                <Border IsVisible="{Binding HasError}" Background="{StaticResource AccentWashBrush}"
                                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8">
                                    <TextBlock Text="{Binding Error}" FontSize="10.5" TextWrapping="Wrap"
                                               Foreground="{StaticResource AccentDeepBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 预览 -->
            <Border Grid.Column="1" Classes="workspace-panel" Padding="16">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="导出预览" Classes="section-title" />
                            <TextBlock Text="{Binding PreviewCaption}" Classes="helper"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="PREVIEW" Classes="eyebrow" />
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource PaperBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="8">
                        <Panel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding HasPreview}">
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                       AutomationProperties.Name="导出预览" />
                            </ScrollViewer>

                            <StackPanel IsVisible="{Binding ShowPreviewEmpty}" Spacing="6"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PreviewEmptyText}" Classes="helper" FontSize="11"
                                           TextAlignment="Center" MaxWidth="280" />
                            </StackPanel>

                            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsPreviewBusy}"
                                         VerticalAlignment="Bottom" Height="2" />
                        </Panel>
                    </Border>

                    <TextBlock Grid.Row="2" Text="{Binding PreviewDetail}" Classes="helper"
                               Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding ExportSummary}" Classes="helper"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Classes="primary top" Content="选择位置并导出" Click="OnExport"
                        IsDefault="True" Padding="16,7"
                        AutomationProperties.Name="导出" />
                <Button Grid.Column="2" Classes="ghost top" Content="取消" Click="OnCancel"
                        Padding="14,7" IsCancel="True"
                        AutomationProperties.Name="取消导出" />
            </Grid>
        </Border>
    </Grid>
</Window>
