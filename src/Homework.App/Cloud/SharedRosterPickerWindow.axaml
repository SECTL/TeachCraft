<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cloud="using:Homework.App.Cloud"
        x:Class="Homework.App.Cloud.SharedRosterPickerWindow"
        x:DataType="cloud:HomeworkRosterPickerViewModel"
        Title="共享名单"
        Width="720" Height="560"
        MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}">
    <Window.Styles>
        <Style Selector="Border.roster-row">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style Selector="Border.roster-row:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        </Style>
        <Style Selector="Border.roster-row.disabled">
            <Setter Property="Background" Value="{StaticResource WashBrush}" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- 标题 -->
        <Border Grid.Row="0" Classes="dialog-header">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                    <TextBlock Text="共享名单" Classes="section-title" FontSize="18" />
                    <TextBlock Text="从共享库按班拉取名单，只读取姓名与学号。" Classes="helper" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="SHARED ROSTER" Classes="eyebrow" />
            </Grid>
        </Border>

        <!-- 状态条：忙碌与错误互斥显示 -->
        <Grid Grid.Row="1" MinHeight="34">
            <Border Padding="20,7" IsVisible="{Binding IsBusy}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressBar Width="110" Height="3" IsIndeterminate="True" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" Classes="helper"
                               Foreground="{StaticResource InkSoftBrush}" />
                </StackPanel>
            </Border>
            <Border Padding="20,7" IsVisible="{Binding HasError}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" Classes="helper"
                               Foreground="{StaticResource AccentDeepBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost top" Content="重试" Click="OnRefresh"
                            Padding="10,4" FontSize="11" AutomationProperties.Name="重试读取共享名单" />
                </Grid>
            </Border>
        </Grid>

        <!-- 主体：未登录 / 空库 / 名单列表 -->
        <Grid Grid.Row="2" Margin="16,8">
            <Border IsVisible="{Binding !IsAvailable}" Classes="workspace-panel"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Padding="26,22">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="SECTL CLOUD" Classes="eyebrow" HorizontalAlignment="Center" />
                    <TextBlock Text="登录后可以拉取共享名单" Classes="section-title"
                               FontSize="17" HorizontalAlignment="Center" />
                    <TextBlock Text="在「归位」把班级名单保存到共享库后，就能在这里按班拉取。"
                               Classes="helper" TextAlignment="Center" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                Margin="0,4,0,0">
                        <Button Classes="primary top" Content="登录…" Click="OnSignIn"
                                AutomationProperties.Name="登录共享账号" />
                        <Button Classes="ghost top" Content="账号设置…" Click="OnAccountSettings"
                                AutomationProperties.Name="打开账号设置" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsEmpty}" Classes="workspace-panel"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Padding="26,22">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <TextBlock Text="共享名单库还是空的。请先在「归位」把班级名单保存到共享库。"
                               Classes="section-title" FontSize="15" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" />
                    <Button Classes="ghost top" Content="重新读取" Click="OnRefresh"
                            HorizontalAlignment="Center" AutomationProperties.Name="重新读取共享名单" />
                </StackPanel>
            </Border>

            <Grid IsVisible="{Binding ShowList}" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="选择要导入的班级（同名班级只能选一份）"
                               Classes="helper" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost top" Content="重新读取" Click="OnRefresh"
                            Padding="10,4" FontSize="11" AutomationProperties.Name="重新读取共享名单" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="cloud:HomeworkRosterPickerRow">
                                <Border Classes="roster-row" Classes.disabled="{Binding !CanSelect}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanSelect}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="选择这份共享名单" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           FontFamily="{StaticResource SerifFont}" FontSize="14"
                                                           Foreground="{StaticResource InkBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding VersionText}"
                                                           Classes="meta" FontFamily="{StaticResource MonoFont}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding FieldsSummary}" Classes="meta"
                                                       TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="14">
                                                <TextBlock Grid.Column="0" Text="{Binding StudentsText}"
                                                           Classes="meta" />
                                                <TextBlock Grid.Column="1" Text="{Binding UpdatedText}"
                                                           Classes="meta" FontFamily="{StaticResource MonoFont}" />
                                            </Grid>
                                            <TextBlock Text="{Binding DisabledReason}" Classes="meta"
                                                       Foreground="{StaticResource AccentDeepBrush}"
                                                       IsVisible="{Binding !CanSelect}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 页脚 -->
        <Border Grid.Row="3" Classes="dialog-footer">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConfirmText}" Classes="helper"
                               Foreground="{StaticResource InkSoftBrush}" />
                    <TextBlock Text="只读取姓名与学号，不会带入性别等其它字段。" Classes="meta" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="ghost top" Content="全选" Click="OnSelectAll"
                            AutomationProperties.Name="全选共享名单" />
                    <Button Classes="ghost top" Content="清空" Click="OnClearSelection"
                            AutomationProperties.Name="清空选择" />
                    <Button Classes="ghost top" Content="取消" Click="OnCancel" IsCancel="True"
                            AutomationProperties.Name="取消拉取" />
                    <Button Classes="primary top" Content="导入" Click="OnPull" IsEnabled="{Binding CanPull}"
                            IsDefault="True" Padding="16,7" AutomationProperties.Name="确认拉取共享名单" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
