<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TeachCraft.App.ViewModels"
        xmlns:views="using:TeachCraft.App.Views"
        xmlns:controls="using:TeachCraft.App.Controls"
        xmlns:conv="using:TeachCraft.App.Converters"
        x:Class="TeachCraft.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:Name="Root"
        Title="知微 · TeachCraft"
        Icon="avares://TeachCraft/Assets/teachcraft.ico"
        Width="1200" Height="840"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PaperBrush}"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="OnDragOver"
        DragDrop.Drop="OnDrop">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="232,*">
        <!-- ==================== 侧栏 ==================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="16,24,16,14">
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Spacing="11" Margin="4,0,0,0">
                        <Viewbox Width="36" Height="36">
                            <Canvas Width="120" Height="120">
                                <Rectangle Canvas.Left="10" Canvas.Top="10" Width="100" Height="100"
                                           RadiusX="24" RadiusY="24" Fill="#FAF9F5"
                                           Stroke="#E7E3D8" StrokeThickness="3"/>
                                <Rectangle Canvas.Left="26" Canvas.Top="30" Width="46" Height="12"
                                           RadiusX="3" RadiusY="3" Fill="#141413"/>
                                <Rectangle Canvas.Left="76" Canvas.Top="30" Width="18" Height="12"
                                           RadiusX="3" RadiusY="3" Fill="#D97757"/>
                                <Rectangle Canvas.Left="26" Canvas.Top="48" Width="68" Height="16"
                                           RadiusX="3" RadiusY="3" Fill="#E7E3D8"/>
                                <Rectangle Canvas.Left="28" Canvas.Top="50" Width="22" Height="12"
                                           RadiusX="2" RadiusY="2" Fill="#3D3B36"/>
                                <Rectangle Canvas.Left="54" Canvas.Top="50" Width="38" Height="12"
                                           RadiusX="2" RadiusY="2" Fill="#FAF9F5"/>
                                <Rectangle Canvas.Left="58" Canvas.Top="53" Width="20" Height="6"
                                           RadiusX="1.5" RadiusY="1.5" Fill="#85806F"/>
                                <Rectangle Canvas.Left="26" Canvas.Top="70" Width="20" Height="14"
                                           RadiusX="3" RadiusY="3" Fill="#3D3B36"/>
                                <Rectangle Canvas.Left="50" Canvas.Top="70" Width="20" Height="14"
                                           RadiusX="3" RadiusY="3" Fill="#85806F"/>
                                <Rectangle Canvas.Left="74" Canvas.Top="70" Width="20" Height="14"
                                           RadiusX="3" RadiusY="3" Fill="#141413"/>
                                <Line StartPoint="74,22" EndPoint="74,94" Stroke="#D97757"
                                      StrokeThickness="3" StrokeLineCap="Round"/>
                                <Ellipse Canvas.Left="70.5" Canvas.Top="18.5" Width="7" Height="7"
                                         Fill="#D97757"/>
                                <Ellipse Canvas.Left="71.5" Canvas.Top="91.5" Width="5" Height="5"
                                         Fill="#D97757"/>
                            </Canvas>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="知微" FontFamily="{StaticResource SerifFont}" FontSize="18"
                                       LetterSpacing="3" Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="TEACHCRAFT" FontFamily="{StaticResource MonoFont}" FontSize="8"
                                       LetterSpacing="2.4" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*" Margin="6,26,6,8">
                        <TextBlock Grid.Column="0" Text="工作台" FontSize="10" LetterSpacing="1.6"
                                   Foreground="{StaticResource MutedBrush}" />
                        <Border Grid.Column="1" Height="1" Background="{StaticResource LineBrush}"
                                Margin="9,0,0,0" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Spacing="2">
                        <Button Classes="nav" Classes.active="{Binding IsAllActive}" Click="OnNavAll" AutomationProperties.Name="全部工具"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="2" Height="14" CornerRadius="1"
                                        Background="{StaticResource AccentBrush}" Margin="0,0,9,0"
                                        IsVisible="{Binding IsAllActive}" />
                                <TextBlock Grid.Column="1" Text="全部工具" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="10" FontFamily="{StaticResource MonoFont}"
                                           FontSize="10" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Classes="nav" Click="OnNavProject" AutomationProperties.Name="分晓 · 成绩条" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Canvas Width="120" Height="120">
                                        <Rectangle Canvas.Left="10" Canvas.Top="10" Width="100" Height="100"
                                                   RadiusX="24" RadiusY="24" Fill="#FAF9F5"
                                                   Stroke="#E7E3D8" StrokeThickness="3"/>
                                        <Rectangle Canvas.Left="26" Canvas.Top="32" Width="68" Height="12"
                                                   RadiusX="3" RadiusY="3" Fill="#141413"/>
                                        <Rectangle Canvas.Left="26" Canvas.Top="52" Width="68" Height="16"
                                                   RadiusX="3" RadiusY="3" Fill="#E7E3D8"/>
                                        <Rectangle Canvas.Left="28" Canvas.Top="54" Width="38" Height="12"
                                                   RadiusX="2" RadiusY="2" Fill="#3D3B36"/>
                                        <Rectangle Canvas.Left="26" Canvas.Top="76" Width="68" Height="12"
                                                   RadiusX="3" RadiusY="3" Fill="#85806F"/>
                                        <Line StartPoint="72,24" EndPoint="72,96" Stroke="#D97757"
                                              StrokeThickness="3.5" StrokeLineCap="Round"/>
                                        <Ellipse Canvas.Left="68.5" Canvas.Top="20.5" Width="7" Height="7"
                                                 Fill="#D97757"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="分晓 · 成绩条" VerticalAlignment="Center" />
                                <Border Grid.Column="2" BorderBrush="#46C6613F" BorderThickness="1"
                                        CornerRadius="3" Background="#0DD97757" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="常备" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                               Foreground="{StaticResource AccentDeepBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav" Click="OnLaunchSeatGrid" AutomationProperties.Name="归位 · 座位表"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Canvas Width="120" Height="120">
                                        <Rectangle Canvas.Left="10" Canvas.Top="10" Width="100" Height="100"
                                                   RadiusX="24" RadiusY="24" Fill="#FAF9F5"
                                                   Stroke="#E7E3D8" StrokeThickness="3"/>
                                        <Rectangle Canvas.Left="38" Canvas.Top="26" Width="44" Height="9"
                                                   RadiusX="2.5" RadiusY="2.5" Fill="#141413"/>
                                        <Rectangle Canvas.Left="26" Canvas.Top="42" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#3D3B36"/>
                                        <Rectangle Canvas.Left="42" Canvas.Top="42" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#E7E3D8"/>
                                        <Rectangle Canvas.Left="65" Canvas.Top="42" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#85806F"/>
                                        <Rectangle Canvas.Left="81" Canvas.Top="42" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#141413"/>
                                        <Rectangle Canvas.Left="26" Canvas.Top="58" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#85806F"/>
                                        <Rectangle Canvas.Left="42" Canvas.Top="58" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#D97757"/>
                                        <Rectangle Canvas.Left="65" Canvas.Top="58" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#E7E3D8"/>
                                        <Rectangle Canvas.Left="81" Canvas.Top="58" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#3D3B36"/>
                                        <Rectangle Canvas.Left="26" Canvas.Top="74" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#141413"/>
                                        <Rectangle Canvas.Left="42" Canvas.Top="74" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#E7E3D8"/>
                                        <Rectangle Canvas.Left="65" Canvas.Top="74" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#3D3B36"/>
                                        <Rectangle Canvas.Left="81" Canvas.Top="74" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#85806F"/>
                                        <Line StartPoint="57.5,20" EndPoint="57.5,92" Stroke="#D97757"
                                              StrokeThickness="3" StrokeLineCap="Round"/>
                                        <Ellipse Canvas.Left="54" Canvas.Top="16.5" Width="7" Height="7"
                                                 Fill="#D97757"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="归位 · 座位表" VerticalAlignment="Center" />
                                <Border Grid.Column="2" BorderBrush="#46C6613F" BorderThickness="1"
                                        CornerRadius="3" Background="#0DD97757" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="课堂" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                               Foreground="{StaticResource AccentDeepBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav" Click="OnLaunchClassBlock" AutomationProperties.Name="时序 · 课程表"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Canvas Width="120" Height="120">
                                        <Rectangle Canvas.Left="10" Canvas.Top="10" Width="100" Height="100"
                                                   RadiusX="24" RadiusY="24" Fill="#FAF9F5"
                                                   Stroke="#E7E3D8" StrokeThickness="3"/>
                                        <Rectangle Canvas.Left="26" Canvas.Top="26" Width="13" Height="6"
                                                   RadiusX="2" RadiusY="2" Fill="#141413"/>
                                        <Rectangle Canvas.Left="43" Canvas.Top="26" Width="13" Height="6"
                                                   RadiusX="2" RadiusY="2" Fill="#85806F"/>
                                        <Rectangle Canvas.Left="60" Canvas.Top="26" Width="13" Height="6"
                                                   RadiusX="2" RadiusY="2" Fill="#3D3B36"/>
                                        <Rectangle Canvas.Left="77" Canvas.Top="26" Width="17" Height="6"
                                                   RadiusX="2" RadiusY="2" Fill="#E7E3D8"/>
                                        <Rectangle Canvas.Left="26" Canvas.Top="36" Width="13" Height="22"
                                                   RadiusX="2.5" RadiusY="2.5" Fill="#3D3B36"/>
                                        <Rectangle Canvas.Left="26" Canvas.Top="62" Width="13" Height="14"
                                                   RadiusX="2.5" RadiusY="2.5" Fill="#E7E3D8"/>
                                        <Rectangle Canvas.Left="26" Canvas.Top="80" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#85806F"/>
                                        <Rectangle Canvas.Left="43" Canvas.Top="36" Width="13" Height="14"
                                                   RadiusX="2.5" RadiusY="2.5" Fill="#85806F"/>
                                        <Rectangle Canvas.Left="43" Canvas.Top="54" Width="13" Height="22"
                                                   RadiusX="2.5" RadiusY="2.5" Fill="#D97757"/>
                                        <Rectangle Canvas.Left="43" Canvas.Top="80" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#141413"/>
                                        <Rectangle Canvas.Left="60" Canvas.Top="36" Width="13" Height="24"
                                                   RadiusX="2.5" RadiusY="2.5" Fill="#141413"/>
                                        <Rectangle Canvas.Left="60" Canvas.Top="64" Width="13" Height="12"
                                                   RadiusX="2.5" RadiusY="2.5" Fill="#3D3B36"/>
                                        <Rectangle Canvas.Left="60" Canvas.Top="80" Width="13" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#E7E3D8"/>
                                        <Rectangle Canvas.Left="77" Canvas.Top="36" Width="17" Height="16"
                                                   RadiusX="2.5" RadiusY="2.5" Fill="#E7E3D8"/>
                                        <Rectangle Canvas.Left="77" Canvas.Top="56" Width="17" Height="20"
                                                   RadiusX="2.5" RadiusY="2.5" Fill="#85806F"/>
                                        <Rectangle Canvas.Left="77" Canvas.Top="80" Width="17" Height="10"
                                                   RadiusX="2" RadiusY="2" Fill="#3D3B36"/>
                                        <Line StartPoint="72,20" EndPoint="72,94" Stroke="#D97757"
                                              StrokeThickness="3" StrokeLineCap="Round"/>
                                        <Ellipse Canvas.Left="68.5" Canvas.Top="16.5" Width="7" Height="7"
                                                 Fill="#D97757"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="时序 · 课程表" VerticalAlignment="Center" />
                                <Border Grid.Column="2" BorderBrush="#46C6613F" BorderThickness="1"
                                        CornerRadius="3" Background="#0DD97757" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="课堂" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                               Foreground="{StaticResource AccentDeepBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav" Click="OnLaunchGradeWeave" AutomationProperties.Name="织序 · 课表编排"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Canvas Width="120" Height="120">
                                        <Rectangle Canvas.Left="10" Canvas.Top="10" Width="100" Height="100"
                                                   RadiusX="24" RadiusY="24" Fill="#FAF9F5"
                                                   Stroke="#E7E3D8" StrokeThickness="3"/>
                                        <Line StartPoint="45,28" EndPoint="45,92" Stroke="#D6D1C4" StrokeThickness="3"/>
                                        <Line StartPoint="75,28" EndPoint="75,92" Stroke="#D6D1C4" StrokeThickness="3"/>
                                        <Line StartPoint="26,48" EndPoint="94,48" Stroke="#D6D1C4" StrokeThickness="3"/>
                                        <Line StartPoint="26,72" EndPoint="94,72" Stroke="#D6D1C4" StrokeThickness="3"/>
                                        <Polyline Points="26,62 38,46 50,72 62,44 74,70 88,50 94,62"
                                                  Stroke="#D97757" StrokeThickness="3"
                                                  StrokeLineCap="Round" StrokeJoin="Round"/>
                                        <Ellipse Canvas.Left="22.5" Canvas.Top="58.5" Width="7" Height="7"
                                                 Fill="#D97757"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="织序 · 课表编排" VerticalAlignment="Center" />
                                <Border Grid.Column="2" BorderBrush="#46C6613F" BorderThickness="1"
                                        CornerRadius="3" Background="#0DD97757" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="编排" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                               Foreground="{StaticResource AccentDeepBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button Classes="nav" Click="OnLaunchMeetRoster"
                                AutomationProperties.Name="竞名 · 运动会报名" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Canvas Width="120" Height="120">
                                        <Rectangle Canvas.Left="10" Canvas.Top="10" Width="100" Height="100"
                                                   RadiusX="24" RadiusY="24" Fill="#FAF9F5"
                                                   Stroke="#E7E3D8" StrokeThickness="3"/>
                                        <Rectangle Canvas.Left="30" Canvas.Top="38" Width="52" Height="7"
                                                   RadiusX="3" RadiusY="3" Fill="#141413"/>
                                        <Rectangle Canvas.Left="30" Canvas.Top="56" Width="46" Height="7"
                                                   RadiusX="3" RadiusY="3" Fill="#3D3B36"/>
                                        <Rectangle Canvas.Left="30" Canvas.Top="74" Width="52" Height="7"
                                                   RadiusX="3" RadiusY="3" Fill="#E7E3D8"/>
                                        <Rectangle Canvas.Left="30" Canvas.Top="92" Width="38" Height="7"
                                                   RadiusX="3" RadiusY="3" Fill="#6F6A5E"/>
                                        <Line StartPoint="88,34" EndPoint="88,88"
                                              Stroke="#D97757" StrokeThickness="4" StrokeLineCap="Round"/>
                                        <Ellipse Canvas.Left="72" Canvas.Top="40" Width="8" Height="8"
                                                 Fill="#D97757"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="竞名 · 运动会报名" VerticalAlignment="Center" />
                                <Border Grid.Column="2" BorderBrush="#46C6613F" BorderThickness="1"
                                        CornerRadius="3" Background="#0DD97757" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="报名" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                               Foreground="{StaticResource AccentDeepBrush}" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*" Margin="6,24,6,8">
                        <TextBlock Grid.Column="0" Text="分类" FontSize="10" LetterSpacing="1.6"
                                   Foreground="{StaticResource MutedBrush}" />
                        <Border Grid.Column="1" Height="1" Background="{StaticResource LineBrush}"
                                Margin="9,0,0,0" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Spacing="2">
                        <Button Classes="nav" Classes.active="{Binding IsImageActive}" Click="OnNavImage" AutomationProperties.Name="图片处理"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="2" Height="14" CornerRadius="1"
                                        Background="{StaticResource AccentBrush}" Margin="0,0,9,0"
                                        IsVisible="{Binding IsImageActive}" />
                                <TextBlock Grid.Column="1" Text="图片处理" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="04" FontFamily="{StaticResource MonoFont}"
                                           FontSize="10" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsFileActive}" Click="OnNavFile" AutomationProperties.Name="格式工厂"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="2" Height="14" CornerRadius="1"
                                        Background="{StaticResource AccentBrush}" Margin="0,0,9,0"
                                        IsVisible="{Binding IsFileActive}" />
                                <TextBlock Grid.Column="1" Text="格式工厂" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="06" FontFamily="{StaticResource MonoFont}"
                                           FontSize="10" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="7" Margin="6,0">
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource MossBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="LOCAL ONLY" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                   LetterSpacing="1.6" Foreground="{StaticResource MossBrush}" />
                    </StackPanel>
                    <TextBlock Text="你的文件只在本机处理、从不上传；更新相关的少量记录与安装包只留在本机。检查更新需要联网读取版本号，也不发送任何本机信息。" FontSize="10.5"
                               LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    <!-- 检查更新：本应用唯一的联网入口，放在联网说明与版本号之间（原在状态栏右侧） -->
                    <Button Classes="nav nav-action" Margin="-6,2,-6,0" Padding="6,7" HorizontalAlignment="Stretch"
                            Click="OnCheckUpdateClick" AutomationProperties.Name="检查更新">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                                  Data="M 13.5,8 A 5.5,5.5 0 1 1 12.21,4.46 M 12.21,1.9 L 12.21,4.46 L 9.65,4.46"
                                  Stroke="{StaticResource InkSoftBrush}" StrokeThickness="1.3"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                            <TextBlock Text="检查更新" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding VersionText}" FontFamily="{StaticResource MonoFont}" FontSize="9"
                               LetterSpacing="1.2" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主区 ==================== -->
        <Grid Grid.Column="1" RowDefinitions="*,Auto">
            <ScrollViewer x:Name="MainScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <Border MaxWidth="1104" Margin="40,30,40,36" HorizontalAlignment="Center">
                    <StackPanel Spacing="0">

                        <!-- 页首 -->
                        <Grid ColumnDefinitions="*,300" Margin="0,0,0,28">
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="18" Height="1" Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center" Opacity="0.8" />
                                    <TextBlock Text="TOOLBOX / 教师工具箱" FontFamily="{StaticResource MonoFont}"
                                               FontSize="10" LetterSpacing="2.6"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,10">
                                    <TextBlock Text="知微" FontFamily="{StaticResource SerifFont}" FontSize="52"
                                               LetterSpacing="-1" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="TeachCraft" FontFamily="{StaticResource SerifFont}" FontSize="15"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"
                                               Margin="0,0,0,12" />
                                </StackPanel>

                                <TextBlock Text="见微知著。把成绩、座位、图片与文档里的琐碎，收进一只放在案头的盒子。"
                                           FontSize="12.5" LineHeight="24" Foreground="{StaticResource InkSoftBrush}" />

                                <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,12,0,0">
                                    <TextBlock Text="10 件工具 · 5 件常备" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                               LetterSpacing="1.3" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="/" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                               Foreground="#C9C1AE" />
                                    <TextBlock Text="本机处理" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                               LetterSpacing="1.3" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="/" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                               Foreground="#C9C1AE" />
                                    <TextBlock Text="除更新外不联网" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                               LetterSpacing="1.3" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="9">
                                <Panel>
                                    <TextBox x:Name="SearchBox" Classes="search"
                                             Text="{Binding SearchText, Mode=TwoWay}"
                                             PlaceholderText="搜索工具或格式"
                                             AutomationProperties.Name="搜索工具或格式" />
                                    <Path Width="13" Height="13" Stretch="Uniform" Margin="12,0,0,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Data="M6 1.4 A4.6 4.6 0 1 1 6 10.6 A4.6 4.6 0 1 1 6 1.4 M9.6 9.6 L13 13"
                                          Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3"
                                          StrokeLineCap="Round" IsHitTestVisible="False" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            CornerRadius="4" Background="{StaticResource PaperBrush}"
                                            Padding="4,2" IsHitTestVisible="False">
                                        <TextBlock Text="CTRL K" FontFamily="{StaticResource MonoFont}" FontSize="8.5"
                                                   LetterSpacing="0.8" Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                </Panel>
                                <TextBlock Text="{Binding SearchSummary}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="9" LetterSpacing="1.2" Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,26" />

                        <!-- 01 案头常备 -->
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,14"
                              IsVisible="{Binding HasPinnedResults}">
                            <TextBlock Text="01" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource AccentDeepBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="案头常备" FontFamily="{StaticResource SerifFont}"
                                       FontSize="19" LetterSpacing="0.2" Foreground="{StaticResource InkBrush}"
                                       Margin="12,0,0,0" />
                            <TextBlock Grid.Column="2" Text="PINNED" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                       LetterSpacing="2" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                            <Border Grid.Column="3" Height="1" Background="{StaticResource LineBrush}"
                                    Margin="12,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding PinnedCountLabel}" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 分晓 · GradeStrip：与其他常备卡同一套行卡；原大卡上的成绩条预览与「项目详情」收进点开后的说明区 -->
                        <Border Classes="app-card" Classes.expanded="{Binding GradeStripCard.IsDescriptionExpanded}"
                                BorderThickness="1" CornerRadius="10" Padding="18,14"
                                IsVisible="{Binding IsGradeStripVisible}" Focusable="True" Cursor="Hand"
                                Tag="{Binding GradeStripCard}"
                                PointerPressed="OnAppCardPressed" KeyDown="OnAppCardKeyDown"
                                AutomationProperties.Name="{Binding GradeStripCard.DescriptionAccessibleName}"
                                ToolTip.Tip="{Binding GradeStripCard.DescriptionToggleLabel}">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="46,*,Auto,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="7"
                                        Background="#FCFAF4" BorderBrush="#E3DDCE" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <!-- 分晓图标的缩小版：三条成绩条 + 陶土色裁切线 -->
                                    <Canvas Width="30" Height="30">
                                        <Rectangle Canvas.Left="2" Canvas.Top="5.5" Width="26" Height="4.5"
                                                   RadiusX="1" RadiusY="1" Fill="#141413" />
                                        <Rectangle Canvas.Left="2" Canvas.Top="13" Width="26" Height="6"
                                                   RadiusX="1" RadiusY="1" Fill="#E7E3D8" />
                                        <Rectangle Canvas.Left="3" Canvas.Top="13.75" Width="14" Height="4.5"
                                                   RadiusX="1" RadiusY="1" Fill="#3D3B36" />
                                        <Rectangle Canvas.Left="2" Canvas.Top="22" Width="26" Height="4.5"
                                                   RadiusX="1" RadiusY="1" Fill="#85806F" />
                                        <Line StartPoint="19.5,3" EndPoint="19.5,29" Stroke="#D97757"
                                              StrokeThickness="1.4" StrokeLineCap="Round" />
                                        <Ellipse Canvas.Left="18" Canvas.Top="1" Width="3" Height="3" Fill="#D97757" />
                                    </Canvas>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="GRADESTRIP / 分晓" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                               LetterSpacing="2.2" Foreground="{StaticResource MutedBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="分晓" FontFamily="{StaticResource SerifFont}" FontSize="21" LetterSpacing="0.2" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="· GradeStrip" FontFamily="{StaticResource SerifFont}" FontSize="14"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                    </StackPanel>
                                    <TextBlock Text="把智学网导出的成绩总表，变成一叠可以裁开的成绩条。"
                                               FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource MossBrush}" />
                                        <TextBlock Text="已就绪" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                   Foreground="{StaticResource MossBrush}" />
                                    </StackPanel>
                                    <Button Classes="primary" Content="打开应用" Click="OnLaunchGradeStrip" />
                                </StackPanel>

                                <Path Grid.Column="3" Classes="tool-chevron"
                                      Classes.expanded="{Binding GradeStripCard.IsDescriptionExpanded}"
                                      Data="M 1 1 L 6 6 L 11 1"
                                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="12" Height="7" VerticalAlignment="Center"
                                      IsHitTestVisible="False" />
                            </Grid>

                            <!-- 说明区：左边是与其他卡同源的说明（ToolDescriptionCatalog），右边是原大卡的成绩条预览 -->
                            <controls:ExpandReveal IsExpanded="{Binding GradeStripCard.IsDescriptionExpanded}"
                                                   Duration="0:0:0.26">
                                <StackPanel Margin="0,15,0,0">
                                    <Border Height="1" Background="{StaticResource LineBrush}"
                                            Margin="0,0,0,14" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="28">
                                        <views:ToolDescriptionView DataContext="{Binding GradeStripCard.Detail}" />
                                        <controls:StripPreview Grid.Column="1" VerticalAlignment="Top" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
                                        <Button Classes="link" Content="收起说明" FontSize="11.5" VerticalAlignment="Center"
                                                Click="OnCollapseAppDescription" Tag="{Binding GradeStripCard}" />
                                        <Button Grid.Column="2" Classes="ghost" Content="项目详情" Click="OnOpenProject" />
                                    </Grid>
                                </StackPanel>
                            </controls:ExpandReveal>
                            </StackPanel>
                        </Border>

                        <!-- 归位 · SeatGrid -->
                        <Border Classes="app-card" Classes.expanded="{Binding SeatGridCard.IsDescriptionExpanded}"
                                BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,10,0,0"
                                IsVisible="{Binding IsSeatGridVisible}" Focusable="True" Cursor="Hand"
                                Tag="{Binding SeatGridCard}"
                                PointerPressed="OnAppCardPressed" KeyDown="OnAppCardKeyDown"
                                AutomationProperties.Name="{Binding SeatGridCard.DescriptionAccessibleName}"
                                ToolTip.Tip="{Binding SeatGridCard.DescriptionToggleLabel}">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="46,*,Auto,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="7"
                                        Background="#FCFAF4" BorderBrush="#E3DDCE" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Canvas Width="30" Height="30">
                                        <Rectangle Canvas.Left="0" Canvas.Top="2" Width="13" Height="8" RadiusX="2" RadiusY="2"
                                                   Fill="#FFFFFF" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Rectangle Canvas.Left="16" Canvas.Top="2" Width="13" Height="8" RadiusX="2" RadiusY="2"
                                                   Fill="#FAF9F5" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Rectangle Canvas.Left="0" Canvas.Top="12" Width="13" Height="8" RadiusX="2" RadiusY="2"
                                                   Fill="#FAF9F5" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Rectangle Canvas.Left="16" Canvas.Top="12" Width="13" Height="8" RadiusX="2" RadiusY="2"
                                                   Fill="#D97757" Stroke="#C6613F" StrokeThickness="1" />
                                        <Rectangle Canvas.Left="0" Canvas.Top="22" Width="13" Height="8" RadiusX="2" RadiusY="2"
                                                   Fill="#FFFFFF" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Rectangle Canvas.Left="16" Canvas.Top="22" Width="13" Height="8" RadiusX="2" RadiusY="2"
                                                   Fill="#FAF9F5" Stroke="#D6D1C4" StrokeThickness="1" />
                                    </Canvas>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="SEATGRID / 归位" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                               LetterSpacing="2.2" Foreground="{StaticResource MutedBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="归位" FontFamily="{StaticResource SerifFont}" FontSize="21" LetterSpacing="0.2" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="· SeatGrid" FontFamily="{StaticResource SerifFont}" FontSize="14"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                    </StackPanel>
                                    <TextBlock Text="导入名单，自动识别姓名与性别；排座、预览、打印与导出一次完成。"
                                               FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource MossBrush}" />
                                        <TextBlock Text="已就绪" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                   Foreground="{StaticResource MossBrush}" />
                                    </StackPanel>
                                    <Button Classes="primary" Content="打开应用" Click="OnLaunchSeatGrid" />
                                </StackPanel>

                                <Path Grid.Column="3" Classes="tool-chevron"
                                      Classes.expanded="{Binding SeatGridCard.IsDescriptionExpanded}"
                                      Data="M 1 1 L 6 6 L 11 1"
                                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="12" Height="7" VerticalAlignment="Center"
                                      IsHitTestVisible="False" />
                            </Grid>

                            <controls:ExpandReveal IsExpanded="{Binding SeatGridCard.IsDescriptionExpanded}"
                                                   Duration="0:0:0.26">
                                <StackPanel Margin="0,15,0,0">
                                    <Border Height="1" Background="{StaticResource LineBrush}"
                                            Margin="0,0,0,14" />
                                    <views:ToolDescriptionView DataContext="{Binding SeatGridCard.Detail}" />
                                    <Button Classes="link" Content="收起说明" FontSize="11.5"
                                            HorizontalAlignment="Left" Margin="0,14,0,0"
                                            Click="OnCollapseAppDescription" Tag="{Binding SeatGridCard}" />
                                </StackPanel>
                            </controls:ExpandReveal>
                            </StackPanel>
                        </Border>

                        <!-- 时序 · ClassBlock -->
                        <Border Classes="app-card" Classes.expanded="{Binding ClassBlockCard.IsDescriptionExpanded}"
                                BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,10,0,0"
                                IsVisible="{Binding IsClassBlockVisible}" Focusable="True" Cursor="Hand"
                                Tag="{Binding ClassBlockCard}"
                                PointerPressed="OnAppCardPressed" KeyDown="OnAppCardKeyDown"
                                AutomationProperties.Name="{Binding ClassBlockCard.DescriptionAccessibleName}"
                                ToolTip.Tip="{Binding ClassBlockCard.DescriptionToggleLabel}">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="46,*,Auto,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="7"
                                        Background="#FCFAF4" BorderBrush="#E3DDCE" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Canvas Width="30" Height="30">
                                        <Rectangle Canvas.Left="0" Canvas.Top="3" Width="30" Height="24"
                                                   RadiusX="2" RadiusY="2" Fill="#FFFFFF"
                                                   Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Line StartPoint="0,11" EndPoint="30,11" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Line StartPoint="0,19" EndPoint="30,19" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Line StartPoint="10,3" EndPoint="10,27" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Line StartPoint="20,3" EndPoint="20,27" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Rectangle Canvas.Left="11" Canvas.Top="12" Width="8" Height="6"
                                                   RadiusX="1" RadiusY="1" Fill="#D97757" />
                                    </Canvas>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="CLASSBLOCK / 时序" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                               LetterSpacing="2.2" Foreground="{StaticResource MutedBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="时序" FontFamily="{StaticResource SerifFont}" FontSize="21" LetterSpacing="0.2" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="· ClassBlock" FontFamily="{StaticResource SerifFont}" FontSize="14"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                    </StackPanel>
                                    <TextBlock Text="导入课程总表，自动识别年级与班级；选中班级即可得到可直接打印的课程表。"
                                               FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource MossBrush}" />
                                        <TextBlock Text="已就绪" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                   Foreground="{StaticResource MossBrush}" />
                                    </StackPanel>
                                    <Button Classes="primary" Content="打开应用" Click="OnLaunchClassBlock" />
                                </StackPanel>

                                <Path Grid.Column="3" Classes="tool-chevron"
                                      Classes.expanded="{Binding ClassBlockCard.IsDescriptionExpanded}"
                                      Data="M 1 1 L 6 6 L 11 1"
                                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="12" Height="7" VerticalAlignment="Center"
                                      IsHitTestVisible="False" />
                            </Grid>

                            <controls:ExpandReveal IsExpanded="{Binding ClassBlockCard.IsDescriptionExpanded}"
                                                   Duration="0:0:0.26">
                                <StackPanel Margin="0,15,0,0">
                                    <Border Height="1" Background="{StaticResource LineBrush}"
                                            Margin="0,0,0,14" />
                                    <views:ToolDescriptionView DataContext="{Binding ClassBlockCard.Detail}" />
                                    <Button Classes="link" Content="收起说明" FontSize="11.5"
                                            HorizontalAlignment="Left" Margin="0,14,0,0"
                                            Click="OnCollapseAppDescription" Tag="{Binding ClassBlockCard}" />
                                </StackPanel>
                            </controls:ExpandReveal>
                            </StackPanel>
                        </Border>

                        <!-- 织序 · GradeWeave -->
                        <Border Classes="app-card" Classes.expanded="{Binding GradeWeaveCard.IsDescriptionExpanded}"
                                BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,10,0,0"
                                IsVisible="{Binding IsGradeWeaveVisible}" Focusable="True" Cursor="Hand"
                                Tag="{Binding GradeWeaveCard}"
                                PointerPressed="OnAppCardPressed" KeyDown="OnAppCardKeyDown"
                                AutomationProperties.Name="{Binding GradeWeaveCard.DescriptionAccessibleName}"
                                ToolTip.Tip="{Binding GradeWeaveCard.DescriptionToggleLabel}">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="46,*,Auto,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="7"
                                        Background="#FCFAF4" BorderBrush="#E3DDCE" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Canvas Width="30" Height="30">
                                        <Rectangle Canvas.Left="0" Canvas.Top="3" Width="30" Height="24"
                                                   RadiusX="2" RadiusY="2" Fill="#FFFFFF"
                                                   Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Line StartPoint="10,3" EndPoint="10,27" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Line StartPoint="20,3" EndPoint="20,27" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Line StartPoint="0,11" EndPoint="30,11" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Line StartPoint="0,19" EndPoint="30,19" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Polyline Points="2,15 7,7 12,21 17,6 22,20 26,9 28,15"
                                                  Stroke="#D97757" StrokeThickness="1.6"
                                                  StrokeLineCap="Round" StrokeJoin="Round" />
                                        <Ellipse Canvas.Left="0.5" Canvas.Top="13.5" Width="3" Height="3"
                                                 Fill="#D97757" />
                                    </Canvas>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="GRADEWEAVE / 织序" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                               LetterSpacing="2.2" Foreground="{StaticResource MutedBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="织序" FontFamily="{StaticResource SerifFont}" FontSize="21" LetterSpacing="0.2" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="· GradeWeave" FontFamily="{StaticResource SerifFont}" FontSize="14"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                    </StackPanel>
                                    <TextBlock Text="全年级课表编排：教研、走班、会议先定，再一次排清冲突。"
                                               FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource MossBrush}" />
                                        <TextBlock Text="首版" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                   Foreground="{StaticResource MossBrush}" />
                                    </StackPanel>
                                    <Button Classes="primary" Content="打开应用" Click="OnLaunchGradeWeave" />
                                </StackPanel>

                                <Path Grid.Column="3" Classes="tool-chevron"
                                      Classes.expanded="{Binding GradeWeaveCard.IsDescriptionExpanded}"
                                      Data="M 1 1 L 6 6 L 11 1"
                                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="12" Height="7" VerticalAlignment="Center"
                                      IsHitTestVisible="False" />
                            </Grid>

                            <controls:ExpandReveal IsExpanded="{Binding GradeWeaveCard.IsDescriptionExpanded}"
                                                   Duration="0:0:0.26">
                                <StackPanel Margin="0,15,0,0">
                                    <Border Height="1" Background="{StaticResource LineBrush}"
                                            Margin="0,0,0,14" />
                                    <views:ToolDescriptionView DataContext="{Binding GradeWeaveCard.Detail}" />
                                    <Button Classes="link" Content="收起说明" FontSize="11.5"
                                            HorizontalAlignment="Left" Margin="0,14,0,0"
                                            Click="OnCollapseAppDescription" Tag="{Binding GradeWeaveCard}" />
                                </StackPanel>
                            </controls:ExpandReveal>
                            </StackPanel>
                        </Border>

                        <!-- 竞名 · MeetRoster -->
                        <Border Classes="app-card" Classes.expanded="{Binding MeetRosterCard.IsDescriptionExpanded}"
                                BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,10,0,0"
                                IsVisible="{Binding IsMeetRosterVisible}" Focusable="True" Cursor="Hand"
                                Tag="{Binding MeetRosterCard}"
                                PointerPressed="OnAppCardPressed" KeyDown="OnAppCardKeyDown"
                                AutomationProperties.Name="{Binding MeetRosterCard.DescriptionAccessibleName}"
                                ToolTip.Tip="{Binding MeetRosterCard.DescriptionToggleLabel}">
                            <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="46,*,Auto,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="7"
                                        Background="#FCFAF4" BorderBrush="#E3DDCE" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Canvas Width="30" Height="30">
                                        <Rectangle Canvas.Left="0" Canvas.Top="3" Width="30" Height="24"
                                                   RadiusX="2" RadiusY="2" Fill="#FFFFFF"
                                                   Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Line StartPoint="0,10" EndPoint="30,10" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Line StartPoint="0,17" EndPoint="30,17" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Line StartPoint="0,24" EndPoint="30,24" Stroke="#D6D1C4" StrokeThickness="1" />
                                        <Rectangle Canvas.Left="3" Canvas.Top="5" Width="12" Height="3"
                                                   RadiusX="1" RadiusY="1" Fill="#141413" />
                                        <Rectangle Canvas.Left="3" Canvas.Top="12" Width="9" Height="3"
                                                   RadiusX="1" RadiusY="1" Fill="#85806F" />
                                        <Rectangle Canvas.Left="3" Canvas.Top="19" Width="13" Height="3"
                                                   RadiusX="1" RadiusY="1" Fill="#3D3B36" />
                                        <Line StartPoint="24,4" EndPoint="24,27"
                                              Stroke="#D97757" StrokeThickness="1.6" StrokeLineCap="Round" />
                                        <Ellipse Canvas.Left="18.5" Canvas.Top="14" Width="3.5" Height="3.5"
                                                 Fill="#D97757" />
                                    </Canvas>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="MEETROSTER / 竞名" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                               LetterSpacing="2.2" Foreground="{StaticResource MutedBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="竞名" FontFamily="{StaticResource SerifFont}" FontSize="21" LetterSpacing="0.2" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="· MeetRoster" FontFamily="{StaticResource SerifFont}" FontSize="14"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                    </StackPanel>
                                    <TextBlock Text="导入班级报名表，按模板录入运动员与项目；赛程表按日期与项目速览。"
                                               FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource MossBrush}" />
                                        <TextBlock Text="首版" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                   Foreground="{StaticResource MossBrush}" />
                                    </StackPanel>
                                    <Button Classes="primary" Content="打开应用" Click="OnLaunchMeetRoster" />
                                </StackPanel>

                                <Path Grid.Column="3" Classes="tool-chevron"
                                      Classes.expanded="{Binding MeetRosterCard.IsDescriptionExpanded}"
                                      Data="M 1 1 L 6 6 L 11 1"
                                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.3"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Width="12" Height="7" VerticalAlignment="Center"
                                      IsHitTestVisible="False" />
                            </Grid>

                            <controls:ExpandReveal IsExpanded="{Binding MeetRosterCard.IsDescriptionExpanded}"
                                                   Duration="0:0:0.26">
                                <StackPanel Margin="0,15,0,0">
                                    <Border Height="1" Background="{StaticResource LineBrush}"
                                            Margin="0,0,0,14" />
                                    <views:ToolDescriptionView DataContext="{Binding MeetRosterCard.Detail}" />
                                    <Button Classes="link" Content="收起说明" FontSize="11.5"
                                            HorizontalAlignment="Left" Margin="0,14,0,0"
                                            Click="OnCollapseAppDescription" Tag="{Binding MeetRosterCard}" />
                                </StackPanel>
                            </controls:ExpandReveal>
                            </StackPanel>
                        </Border>

                        <!-- 02 图片处理 -->
                        <Grid x:Name="ImageSectionHead" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,30,0,14"
                              IsVisible="{Binding HasImageResults}">
                            <TextBlock Text="02" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource AccentDeepBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="图片处理" FontFamily="{StaticResource SerifFont}"
                                       FontSize="19" LetterSpacing="0.2" Foreground="{StaticResource InkBrush}"
                                       Margin="12,0,0,0" />
                            <TextBlock Grid.Column="2" Text="IMAGE" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                       LetterSpacing="2" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                            <Border Grid.Column="3" Height="1" Background="{StaticResource LineBrush}"
                                    Margin="12,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding ImageCountLabel}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl x:Name="ImageToolsList" ItemsSource="{Binding VisibleImageTools}"
                                      IsVisible="{Binding HasImageResults}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 双列但不做等高：一张卡展开说明时，另一张不会被拉出空白 -->
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ToolItemViewModel">
                                    <!-- 工具卡：点卡片或标题展开说明，右上「打开」进抽屉 -->
                                    <views:ToolCardView Margin="0,0,7,7" OpenRequested="OnOpenTool" Expanded="OnToolCardExpanded"
                                                        VerticalAlignment="Top"
                                                        Width="{Binding $parent[ItemsControl].Bounds.Width,
                                                                        Converter={x:Static conv:ColumnWidthConverter.TwoColumns}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 03 格式工厂 -->
                        <Grid x:Name="FileSectionHead" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,30,0,14"
                              IsVisible="{Binding HasFileResults}">
                            <TextBlock Text="03" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource AccentDeepBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="格式工厂" FontFamily="{StaticResource SerifFont}"
                                       FontSize="19" LetterSpacing="0.2" Foreground="{StaticResource InkBrush}"
                                       Margin="12,0,0,0" />
                            <TextBlock Grid.Column="2" Text="FILE / PDF" FontFamily="{StaticResource MonoFont}" FontSize="9"
                                       LetterSpacing="2" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                            <Border Grid.Column="3" Height="1" Background="{StaticResource LineBrush}"
                                    Margin="12,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding FileCountLabel}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl x:Name="FileToolsList" ItemsSource="{Binding VisibleFileTools}"
                                      IsVisible="{Binding HasFileResults}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 双列但不做等高：一张卡展开说明时，另一张不会被拉出空白 -->
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ToolItemViewModel">
                                    <!-- 工具卡：点卡片或标题展开说明，右上「打开」进抽屉 -->
                                    <views:ToolCardView Margin="0,0,7,7" OpenRequested="OnOpenTool" Expanded="OnToolCardExpanded"
                                                        VerticalAlignment="Top"
                                                        Width="{Binding $parent[ItemsControl].Bounds.Width,
                                                                        Converter={x:Static conv:ColumnWidthConverter.TwoColumns}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel IsVisible="{Binding IsEmptyVisible}" Spacing="8" Margin="0,40,0,20">
                            <TextBlock Text="微" FontFamily="{StaticResource SerifFont}" FontSize="30"
                                       Foreground="#C6BFAE" HorizontalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Center" FontSize="12.5"
                                       Foreground="{StaticResource MutedBrush}">
                                <Run Text="没有找到叫「" />
                                <Run Text="{Binding SearchText}" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                                <Run Text="」的工具，换个格式名试试。" />
                            </TextBlock>
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,30,0,0">
                            <Border Grid.ColumnSpan="4" Height="1" Background="{StaticResource LineBrush}"
                                    VerticalAlignment="Top" />
                            <TextBlock Grid.Column="0" Text="知微 · TEACHCRAFT" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9" LetterSpacing="1.1" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" />
                            <TextBlock Grid.Column="1" Text="见微知著" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9" LetterSpacing="1.1" Foreground="{StaticResource MutedBrush}" Margin="14,16,0,0" />
                            <TextBlock Grid.Column="3" Text="DESIGNED AFTER 分晓 · GRADESTRIP"
                                       FontFamily="{StaticResource MonoFont}" FontSize="9" LetterSpacing="1.1"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- 状态栏 -->
            <Border Grid.Row="1" Height="36" Background="{StaticResource PaperBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="40,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   MaxWidth="820" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding StatusText}" />
                    </StackPanel>
                    <!-- 有新版时的非阻塞提示条：与 StatusText 分开的两块视觉，
                         不改变状态栏 Auto,*,Auto 的列语义。 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Right" Margin="12,0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsUpdateAvailable}">
                        <Ellipse Width="6" Height="6" Fill="{Binding WarningBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpdateBadgeText}" FontSize="11"
                                   Foreground="{StaticResource InkSoftBrush}" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding UpdateExplanation}" />
                        <Button Content="更新" Classes="mini"
                                AutomationProperties.Name="下载并安装新版本"
                                Click="OnInstallUpdateClick" />
                        <Button Content="稍后" Classes="mini"
                                AutomationProperties.Name="暂时忽略这次更新"
                                Click="OnDismissUpdateClick" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionLine}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="9" LetterSpacing="1.2"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 抽屉 ==================== -->
        <Grid Grid.ColumnSpan="2" IsVisible="{Binding IsPanelOpen}" ZIndex="10">
            <Border x:Name="Backdrop" Background="{StaticResource OverlayBrush}" PointerPressed="OnBackdropPressed" />
            <Border x:Name="PanelHost" Classes="panel" Width="452" HorizontalAlignment="Right"
                    BoxShadow="-26 0 70 0 #1A141413">
                <Border.RenderTransform>
                    <TranslateTransform X="452" />
                </Border.RenderTransform>
                <Grid ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="28,26,28,32">
                            <views:ToolPanelView x:Name="ToolPanel" DataContext="{Binding SelectedTool}"
                                                 IsVisible="{Binding #Root.DataContext.IsToolPanelOpen}"
                                                 FilePickRequested="OnPickFiles"
                                                 RunRequested="OnRunTool"
                                                 CloseRequested="OnClosePanel" />
                            <views:ProjectPanelView x:Name="ProjectPanel" IsVisible="{Binding IsProjectPanelOpen}"
                                                    CloseRequested="OnClosePanel"
                                                    LaunchRequested="OnProjectLaunch" />
                            <views:UpdatePanelView x:Name="UpdatePanel" IsVisible="{Binding IsUpdatePanelOpen}"
                                                   CloseRequested="OnClosePanel"
                                                   CheckRequested="OnPanelCheckUpdate"
                                                   InstallRequested="OnPanelInstallUpdate"
                                                   DismissRequested="OnPanelDismissUpdate" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

