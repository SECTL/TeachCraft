<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TeachCraft.App.Views"
        x:Class="TeachCraft.App.Views.AccountWindow"
        Title="知微 · 账号与共享名单"
        Width="520" Height="760"
        MinWidth="460" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PaperBrush}">
    <Border Padding="28,26,28,32">
        <views:AccountPanelView x:Name="Panel" />
    </Border>
</Window>
