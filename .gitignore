# 走查截图与本地代理工作区（不进仓库）
outputs/
.workbuddy/

# 走查通道的失败回执：--*-bench / --*-shot 把异常写到「目标 + .error.txt」，
# 目标写成裸目录名时落点是仓库根的 outputs.error.txt，只 ignore outputs/ 目录盖不住它。
*.error.txt

# IDE 生成的发布配置（每位开发机一套，不进仓库）
**/Properties/PublishProfiles/

# Claude Code 会话工具配置（本机）
.claude/

# 集控凭据（2026-11-16）
# 运行时凭据只写 %LOCALAPPDATA%\TeachCraft\Control\，正常不会落进仓库；
# 这几行是防手滑：调试时若把凭据写在项目目录里，git add -A 必须加不进去。
# 只忽略具体文件名，不忽略整个 Control 目录 —— 代码（SectlControlClient.cs 等）要提交。
**/Control/credential.json
**/Control/device_secret*
**/Control/*.secret
src/TeachCraft.Core/Control/*.json
src/TeachCraft.App/Control/*.json

# SECTL 账号与云同步凭据（2026-11-24）
# 运行时 token / 账号 / 设备标识只写 %LOCALAPPDATA%\TeachCraft\Account\，正常不会落进仓库；
# 这几行是防手滑：调试时若把凭据写在项目目录里，git add -A 必须加不进去。
# 只忽略具体文件名，不忽略整个 Account 目录 —— 代码（SectlTokenStore.cs 等）要提交。
**/Account/tokens.json
**/Account/account.json
**/Account/device.json
**/Account/*.secret
src/**/Account/*.json

# 环境变量
.env
.env.*
!.env.example

# 原子写的中间文件（UpdateStateStore / ControlSettingsStore 都是先写 .tmp 再 Move）
*.tmp
*.bak

# Playwright MCP 调试产物（2026-11-25）
.playwright-mcp/
